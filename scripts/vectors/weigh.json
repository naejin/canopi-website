  "cases": [
    {
      "name": "no plants: nothing to weigh",
      "input": { "members": [] },
      "expect": { "lines": [] }
    },
    {
      "name": "while a list loads: checking, never a judgement of part of the palette",
      "input": { "members": ["inga-1", "inga-2", "inga-3", "banana"], "pending": true },
      "expect": "checking"
    },
    {
      "name": "six of eight in one family is a line to weigh naming the six; no water need recorded is not enough to judge",
      "covers": "F1a-B1, F1a-B2",
      "input": { "members": ["inga-1", "inga-2", "inga-3", "inga-4", "inga-5", "inga-6", "banana", "coffee"] },
      "expect": { "lines": [
        { "kind": "family", "says": "family", "family": "Fabaceae", "n": 6, "m": 8, "members": ["inga-1", "inga-2", "inga-3", "inga-4", "inga-5", "inga-6"], "estimate": false },
        { "kind": "water", "says": "water-few", "n": 0, "m": 8, "members": [], "estimate": false }
      ] }
    },
    {
      "name": "eight families, every water need recorded, thirsty beside dry-loving: no family line (no pass claimed), the water mix names both sides",
      "input": { "members": ["oak", "apple", "clover", "mint", "yarrow", "birch", "walnut", "heather"] },
      "expect": { "lines": [
        { "kind": "water", "says": "water-mix", "n": 8, "m": 8, "wet": 3, "dry": 3, "members": ["clover", "mint", "birch", "oak", "yarrow", "heather"], "estimate": false }
      ] }
    },
    {
      "name": "two of ten water needs recorded is not enough to judge, 2 of 10",
      "covers": "F1a-B2",
      "input": { "members": ["oak", "clover", "unrecorded-1", "unrecorded-2", "unrecorded-3", "unrecorded-4", "unrecorded-5", "unrecorded-6", "unrecorded-7", "unrecorded-8"] },
      "expect": { "lines": [
        { "kind": "water", "says": "water-few", "n": 2, "m": 10, "members": [], "estimate": false }
      ] }
    },
    {
      "name": "half recorded is judged (the one threshold)",
      "input": { "members": ["oak", "olive", "almond", "rosemary", "fig", "unrecorded-1", "unrecorded-2", "unrecorded-3", "unrecorded-4", "unrecorded-5"] },
      "expect": { "lines": [
        { "kind": "water", "says": "water-even", "n": 5, "m": 10, "members": [], "estimate": false }
      ] }
    },
    {
      "name": "Seville's thirteen (board MainMore): four of thirteen legumes is a line; nine recorded all take a dry summer, four not recorded",
      "input": { "members": ["olive", "almond", "fig", "pomegranate", "chickpea", "licorice", "broom", "crimson-clover", "rosemary", "myrtle", "pine", "cornflower", "laurustinus"] },
      "expect": { "lines": [
        { "kind": "family", "says": "family", "family": "Fabaceae", "n": 4, "m": 13, "members": ["chickpea", "licorice", "broom", "crimson-clover"], "estimate": false },
        { "kind": "water", "says": "water-even", "n": 9, "m": 13, "members": [], "estimate": false }
      ] }
    },
    {
      "name": "two of three in one family is under the family minimum: no line",
      "input": { "members": ["inga-1", "inga-2", "banana"] },
      "expect": { "lines": [
        { "kind": "water", "says": "water-few", "n": 0, "m": 3, "members": [], "estimate": false }
      ] }
    },
    {
      "name": "on a borrowed list every line carries the estimate term",
      "covers": "F1a-B4",
      "input": { "members": ["inga-1", "inga-2", "inga-3", "inga-4", "inga-5", "inga-6", "banana", "coffee"], "list": "borrowed" },
      "expect": { "lines": [
        { "kind": "family", "says": "family", "family": "Fabaceae", "n": 6, "m": 8, "members": ["inga-1", "inga-2", "inga-3", "inga-4", "inga-5", "inga-6"], "estimate": true },
        { "kind": "water", "says": "water-few", "n": 0, "m": 8, "members": [], "estimate": true }
      ] }
    }
  ]
