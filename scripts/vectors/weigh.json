    "inga-2": { "family": "Fabaceae" },
    "inga-3": { "family": "Fabaceae" },
    "inga-4": { "family": "Fabaceae" },
    "inga-5": { "family": "Fabaceae" },
    "inga-6": { "family": "Fabaceae" },
