    "broom": { "family": "Fabaceae", "drought_tolerance": "High" },
    "crimson-clover": { "family": "Fabaceae", "moisture_use": "Low" },
    "pomegranate": { "family": "Lythraceae" },
    "pine": { "family": "Pinaceae" },
