# Workers static assets: content-named files are cached for a year and never revalidated
# (consortium v2, design check A3). Every other path keeps the platform default.
# /_astro/*: Astro's content-hashed bundles. /data/consortium/*: the database and each photo carry
# a digest of their bytes in their names (scripts/install-consortium.mjs), so new bytes get a new URL.
# /data/climate/*: the canopi-climate tiles sit under <version>-<12 hex of the grid manifest's sha256>/
# (scripts/install-climate.mjs), so a new grid gets new URLs.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/data/consortium/*
  Cache-Control: public, max-age=31536000, immutable
/data/climate/*
  Cache-Control: public, max-age=31536000, immutable
# /version.json: the commit the live site was built from (E3, design check A15), read by CI's live job
# right after a deploy, so never cached.
/version.json
  Cache-Control: no-store
