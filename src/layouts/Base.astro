---
import { locales, defaultLocale, localizedUrl, type Locale } from '../i18n/utils';
import { CANOPI_DOWNLOADS, CANOPI_RELEASE_DATE, CANOPI_RELEASE_URL, CANOPI_VERSION } from '../data/release';
import { climates } from '../data/climates';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  // Pages that only answer a form post stay out of search results.
  noindex?: boolean;
  // The page's path within a locale, for the alternate-language links.
  path?: string;
  // The locales the page exists in (hreflang links); every locale unless a page says otherwise
  // (Field Guides: en and fr).
  alternates?: readonly Locale[];
  // "article" for a Field Guide; pages are "website" otherwise.
  ogType?: 'website' | 'article';
  // The page's JSON-LD; the Canopi app's SoftwareApplication unless a page gives its own.
  structuredData?: Record<string, unknown>;
}

const { title, description, lang, noindex = false, path = '/', alternates = locales, ogType = 'website', structuredData } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// The locale's painting with the wordmark (scripts/make-og-images.py).
const ogImage = new URL(`/og/og-${lang}.jpg`, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/canopi-logo.svg" />
    <link rel="icon" type="image/png" sizes="128x128" href="/canopi-icon-128.png" />
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang tags for every locale the page exists in -->
    {alternates.map((locale) => (
      <link
        rel="alternate"
        hreflang={locale}
        href={new URL(localizedUrl(path, locale), Astro.site)}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(path, Astro.site)} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Canopi" />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Canopi" />
    <meta property="og:locale" content={lang} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData ?? {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Canopi",
      "description": description,
      "url": "https://projectcanopi.com",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "Linux, macOS, Windows",
      "softwareVersion": CANOPI_VERSION,
      "datePublished": CANOPI_RELEASE_DATE,
      "inLanguage": locales,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "license": "https://www.gnu.org/licenses/agpl-3.0.html",
      "publisher": {
        "@type": "NGO",
        "name": "Canopi",
        "url": "https://projectcanopi.com",
        "address": { "@type": "PostalAddress", "addressCountry": "FR" },
        "founder": {
          "@type": "Person",
          "name": "Jean-Pierre Yin",
          "jobTitle": "Founder & President",
          "image": "https://projectcanopi.com/people/jean-pierre-yin.webp"
        }
      },
      "releaseNotes": CANOPI_RELEASE_URL,
      "downloadUrl": Object.values(CANOPI_DOWNLOADS)
    })} />

    <!-- Language detection (first visit only, root page only) -->
    <script is:inline>
      (function() {
        if (location.pathname !== '/') return;
        try {
          if (sessionStorage.getItem('canopi-lang-checked')) return;
          sessionStorage.setItem('canopi-lang-checked', '1');
        } catch { return; }
        var locales = ['fr','es','pt','it','zh','de','ja','ko','nl','ru'];
        var lang = (navigator.language || '').split('-')[0].toLowerCase();
        if (locales.indexOf(lang) !== -1) {
          location.replace('/' + lang + '/');
        }
      })();
    </script>

    <!-- Theme before first paint: a saved choice wins; otherwise CSS follows the system. -->
    <script is:inline>
      try {
        var saved = localStorage.getItem('canopi-theme');
        if (saved === 'dark' || saved === 'light') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
    <!-- The reader's climate before first paint, so their zone's badges are marked from the start (src/scripts/climate.js). -->
    <script is:inline set:html={`try {
        var climate = localStorage.getItem('canopi-climate');
        if (${JSON.stringify(climates)}.indexOf(climate) !== -1) document.documentElement.dataset.climate = climate;
      } catch {}`} />
    <meta name="theme-color" content="#EFE9DD" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161510" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href="/fonts/literata-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    <style is:global>
      @import '../styles/fonts.css';
      @import '../styles/tokens.css';
      @import '../styles/global.css';
      @import '../styles/home.css';
    </style>
  </head>
  <body class="grain">
    <slot />
  </body>
</html>
