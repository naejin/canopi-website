---
import { t, type Locale } from '../i18n/utils';
import { countries } from '../data/network';
interface Props { lang: Locale; }
const { lang } = Astro.props;
---
<section class="network wrap" aria-labelledby="network-title">
  <div class="section-heading"><h2 id="network-title">{t('network.title', lang)}</h2><p>{t('network.description', lang)}</p></div>
  <div id="network-groups">
    {countries.map(country => (
      <details><summary>{t(country.labelKey, lang)}</summary><ul>
        {country.organisations.map(org => (<li><a href={org.url}>{org.name} <span aria-hidden="true">↗</span></a></li>))}
      </ul></details>
    ))}
  </div>
</section>
