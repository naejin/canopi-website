---
import { t, type Locale } from '../i18n/utils';
import { countries } from '../data/network';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const count = countries.reduce((sum, country) => sum + country.organisations.length, 0);
---
<section class="network" id="network" aria-labelledby="network-title">
  <div class="wrap">
    <details class="network-fold">
      <summary><h2 id="network-title">{t('network.summary', lang, { count: String(count) })}</h2></summary>
      <p class="network-note">{t('network.note', lang)}</p>
    <div class="network-grid">
      {countries.map((country) => (
        <section class="network-group">
          <h3>{t(country.labelKey, lang)}</h3>
          <ul role="list">
            {country.organisations.map((org) => (<li><a href={org.url}>{org.name}&nbsp;<span aria-hidden="true">↗</span></a></li>))}
          </ul>
        </section>
      ))}
    </div>
    </details>
  </div>
</section>
