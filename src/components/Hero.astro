---
import { t, type Locale } from '../i18n/utils';
import DownloadDialog from './DownloadDialog.astro';
interface Props { lang: Locale; }
const { lang } = Astro.props;
---
<section class="hero wrap" aria-labelledby="hero-title">
  <div class="intro">
    <p class="eyebrow">{t('hero.tagline', lang)}</p>
    <h1 id="hero-title">{t('hero.headlineTop', lang)}<br /><span>{t('hero.headlineAccent', lang)}</span></h1>
    <div class="actions">
      <a class="button primary" href="#download-options" data-desktop-download>{t('edition.desktop.cta', lang)} <span aria-hidden="true">↓</span></a>
      <a class="text-link" href="https://web.projectcanopi.com/">{t('edition.web.cta', lang)} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
<section class="demo wrap" id="demo" aria-label={t('hero.videoLabel', lang)}>
  <div class="demo-player">
    <video controls playsinline preload="none" poster="/orchard-screenshot.png" aria-label={t('hero.videoLabel', lang)} tabindex="0"><source src="/demo-canopi-720.mp4" type="video/mp4" /></video>
    <button class="play-demo" hidden aria-label={t('hero.play', lang)}><span aria-hidden="true">▶</span></button>
  </div>
</section>
<DownloadDialog lang={lang} />
<script>
  import '../scripts/downloads.js';
  const video = document.querySelector<HTMLVideoElement>('.demo-player video');
  const play = document.querySelector<HTMLButtonElement>('.play-demo');
  if (video && play) {
    video.controls = false;
    play.hidden = false;
    play.addEventListener('click', () => {
      video.controls = true;
      play.hidden = true;
      video.focus();
      video.play().catch(() => { video.controls = true; });
    });
  }
</script>
