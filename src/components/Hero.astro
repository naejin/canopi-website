---
// The brand at first glance and the right download in one click. Without JS the actions are
// Canopi Web and the releases page; src/scripts/downloads.js adapts them to the visitor's system.
import { t, type Locale } from '../i18n/utils';
import { CANOPI_RELEASES_URL, CANOPI_VERSION } from '../data/release';
import { WEB_URL } from '../data/site';
interface Props { lang: Locale; }
const { lang } = Astro.props;
// Day and night paintings in the locale's own tradition; CSS downloads only the one that applies.
const painting = (variant: string) => `url(/hero/hero-${lang}${variant}.jpg)`;
const paintingStyle = [
  `--hero-day:${painting('')}`, `--hero-night:${painting('-night')}`,
  `--hero-day-small:${painting('-1200')}`, `--hero-night-small:${painting('-night-1200')}`,
].join(';');
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-painting" style={paintingStyle} aria-hidden="true"></div>
  <canvas class="hero-mask" aria-hidden="true"></canvas>
  <div class="wrap hero-inner">
    <h1 id="hero-title" class="hero-title">Canopi</h1>
    <p class="hero-tagline">{t('hero.tagline', lang)}</p>
    <div class="hero-actions">
      <a class="button button-primary" data-primary-action href={WEB_URL}>{t('edition.web.cta', lang)} <span aria-hidden="true">↗</span></a>
      <a class="button button-secondary" data-secondary-action href={CANOPI_RELEASES_URL}>{t('edition.desktop.cta', lang)} <span aria-hidden="true">↓</span></a>
    </div>
    <div class="mac-chooser" data-mac-chooser hidden>
      <p>{t('download.pickMac', lang)} <span class="muted">{t('download.helpMac', lang)}</span></p>
      <div class="mac-chips">
        <a class="chip" data-installer="mac-arm">{t('hero.macArm', lang)}</a>
        <a class="chip" data-installer="mac-intel">{t('hero.macIntel', lang)}</a>
      </div>
    </div>
    <p class="install-note" data-install-note role="status" hidden></p>
    <p class="hero-meta">
      <button class="link-button" type="button" data-open-downloads>{t('hero.allSystems', lang)}</button>
      <span class="meta-sep" aria-hidden="true">·</span>
      <span>{t('hero.version', lang, { version: CANOPI_VERSION })}</span>
    </p>
  </div>
</section>
