---
// Every installer, for other systems or another version. The list is rendered here so it works
// without JS; the script marks the visitor's own installer.
import { t, type Locale } from '../i18n/utils';
import { CANOPI_CHECKSUMS_URL, CANOPI_DOWNLOADS, CANOPI_RELEASES_URL } from '../data/release';
import { WEB_URL } from '../data/site';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const groups = [
  ['Windows', [['windows', 'windowsExe', CANOPI_DOWNLOADS.windowsSetupExe], ['windows-msi', 'windowsMsi', CANOPI_DOWNLOADS.windowsMsi]]],
  ['macOS', [['mac-arm', 'macApple', CANOPI_DOWNLOADS.macAppleSiliconDmg], ['mac-intel', 'macIntel', CANOPI_DOWNLOADS.macIntelDmg]]],
  ['Linux', [['linux', 'linuxAppImage', CANOPI_DOWNLOADS.linuxAppImage], ['linux-deb', 'linuxDeb', CANOPI_DOWNLOADS.linuxDeb]]],
] as const;
---
<dialog class="dialog" id="download-dialog" data-downloads-dialog aria-labelledby="downloads-title">
  <div class="dialog-head">
    <h2 id="downloads-title">{t('download.title', lang)}</h2>
    <button class="dialog-close" type="button" data-close-dialog aria-label={t('dialog.close', lang)}><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
  </div>
  <div class="dialog-body">
    <div class="edition">
      <h3>Canopi Web</h3>
      <p>{t('download.webText', lang)}</p>
      <a class="button button-secondary" href={WEB_URL}>{t('edition.web.cta', lang)} <span aria-hidden="true">↗</span></a>
    </div>
    <div class="edition">
      <h3>Canopi Desktop</h3>
      <p>{t('download.desktopText', lang)}</p>
      <div class="installer-groups">
        {groups.map(([group, items]) => (
          <div class="installer-group">
            <h4>{group}</h4>
            <ul role="list">
              {items.map(([key, name, url]) => (
                <li><a class="installer" href={url} data-installer={key}><strong data-installer-name>{t(`edition.installer.${name}`, lang)}</strong><span>{t(`download.detail.${name}`, lang)}</span></a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <p class="dialog-foot">
      <a href={CANOPI_CHECKSUMS_URL}>{t('download.checksums', lang)}</a>
      <span aria-hidden="true">·</span>
      <a href={CANOPI_RELEASES_URL}>{t('download.allReleases', lang)}</a>
    </p>
  </div>
</dialog>
