---
import { t, localizedUrl, type Locale } from '../i18n/utils';
import { CANOPI_RELEASES_URL } from '../data/release';
interface Props { lang: Locale; }
const { lang } = Astro.props;
---
<footer class="wrap">
  <a class="brand" href={localizedUrl('/', lang)} aria-label={t('header.home', lang)}><img src="/canopi-logo.svg" width="28" height="28" alt="" />Canopi</a>
  <span>{t('footer.license', lang)}</span>
  <a href={CANOPI_RELEASES_URL}>{t('download.allReleases', lang)} <span aria-hidden="true">↗</span></a>
</footer>
