---
// The bibliography: the whole list on /bibliography/ (full), or the books marked featured on the home page.
import { t, localizedUrl, type Locale } from '../i18n/utils';
import { themes } from '../data/bibliography';
import { guidesCiting, slugOf } from '../lib/guides';
import { guidePath, guidesPath, guideLangOf } from '../i18n/guides';
interface Props { lang: Locale; full?: boolean; }
const { lang, full = false } = Astro.props;
const Title = full ? 'h1' : 'h2';
const ShelfTitle = full ? 'h2' : 'h3';

// Each book shows its edition in the reader's language when there is one, else its original.
const languageName = new Intl.DisplayNames([lang], { type: 'language' });
const collator = new Intl.Collator(lang);
// Field Guides that cite a book (by its "- id:"), in French for French readers and in English otherwise.
const guideLang = guideLangOf(lang);
const citing = Object.fromEntries(await Promise.all(themes.flatMap((theme) => theme.books).filter((book) => book.id)
  .map(async (book) => [book.id, await guidesCiting(book.id!, guideLang)] as const)));
const shelves = themes
  .map((theme) => ({
    key: theme.key,
    label: t(`bibliography.theme.${theme.key}`, lang),
    books: theme.books
      .filter((book) => full || book.featured)
      .map((book) => {
        const shown = book.editions.find((edition) => edition.lang === lang) ?? book.editions[0];
        // "Title: Subtitle" (or "Titre : sous-titre", "題：副題") sets the subtitle smaller.
        const [title, subtitle] = shown.title.split(/\s*(?::\s+|：\s*)(.*)/s);
        const others = book.editions.filter((edition) => edition !== shown);
        const guides = (book.id ? citing[book.id] : []).map((entry) => ({ href: guidePath(slugOf(entry), lang), title: entry.data.title }));
        return { ...book, shown, others, title, subtitle, guides, by: shown.by ?? book.by, year: shown.year ?? book.year };
      })
      .sort((a, b) => collator.compare(a.shown.title, b.shown.title)),
  }))
  .filter((shelf) => shelf.books.length);
---
<section class="section bibliography" id="bibliography" aria-labelledby="bibliography-title">
  <div class="wrap">
    <header class="section-head">
      <Title id="bibliography-title">{t('bibliography.title', lang)}</Title>
      <p>{t('bibliography.lede', lang)}</p>
      {full && <p class="bibliography-guides"><a href={guidesPath(lang)} hreflang={guideLang}>{t('bibliography.guides', lang)}</a></p>}
    </header>
    {full && (
      <nav class="bibliography-themes" aria-label={t('bibliography.themes', lang)}>
        <ul role="list">
          {shelves.map((shelf) => (
            <li><a class="chip" href={`#${shelf.key}`}>{shelf.label}<span>{shelf.books.length}</span></a></li>
          ))}
        </ul>
      </nav>
    )}
    <div class="bibliography-grid">
      {shelves.map((shelf) => (
        <section class="bibliography-group" id={full ? shelf.key : undefined}>
          <ShelfTitle class="shelf-title">{shelf.label}</ShelfTitle>
          <ul role="list">
            {shelf.books.map((book) => (
              <li class="book" id={full ? book.id : undefined}>
                <a class="book-link" href={book.shown.url} lang={book.shown.lang}>
                  <span class="book-title">{book.title}&nbsp;<span aria-hidden="true">↗</span></span>
                  {book.subtitle && <span class="book-subtitle">{book.subtitle}</span>}
                </a>
                <p class="book-meta">
                  {book.by} · <span class="nowrap">{book.year}{book.shown.lang !== lang && ` · ${languageName.of(book.shown.lang)}`}</span>
                </p>
                {book.climates.length > 0 && (
                  <p class="book-climate">
                    <span>{t('bibliography.climate', lang)}</span>
                    {book.climates.map((climate) => t(`bibliography.climate.${climate}`, lang)).join(' · ')}
                  </p>
                )}
                {book.guides.length > 0 && (
                  <p class="book-guides">
                    <span>{t('bibliography.fieldGuide', lang)}</span>
                    {book.guides.map((guide) => <a href={guide.href} hreflang={guideLang} lang={guideLang}>{guide.title}</a>)}
                  </p>
                )}
                {book.others.length > 0 && (
                  <p class="book-editions">
                    <span>{t('bibliography.alsoIn', lang)}</span>
                    {book.others.map((edition) => (
                      <a href={edition.url} hreflang={edition.lang} title={`${languageName.of(edition.lang)} · ${edition.title}`} aria-label={`${languageName.of(edition.lang)}: ${edition.title}`}>{edition.lang.toUpperCase()}</a>
                    ))}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    {!full && (
      <p class="bibliography-more"><a class="button button-secondary" href={localizedUrl('/bibliography/', lang)}>{t('bibliography.seeAll', lang)}</a></p>
    )}
  </div>
</section>
