---
import { t, locales, languageNames, localizedUrl, type Locale } from '../i18n/utils';
import { DOCS_URL, discordUrl } from '../data/site';
interface Props { lang: Locale; }
const { lang } = Astro.props;
---
<a class="skip-link" href="#main">{t('header.skip', lang)}</a>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={localizedUrl('/', lang)} aria-label={t('header.home', lang)}>
      <img src="/canopi-logo.svg" width="36" height="36" alt="" />
      <span>Canopi</span>
    </a>
    <nav class="header-nav" aria-label={t('header.navigation', lang)}>
      {DOCS_URL && <a class="nav-link" href={DOCS_URL}>{t('header.docs', lang)}</a>}
      <button class="nav-link" type="button" data-open-donate>{t('header.donate', lang)}</button>
      <a class="nav-link nav-discord" href={discordUrl(lang)}>Discord</a>
      <details class="lang-menu" data-lang-menu>
        <summary class="nav-link" aria-label={`${t('header.language', lang)}: ${languageNames[lang]}`}>{lang.toUpperCase()}</summary>
        <ul class="menu-panel" role="list">
          {locales.map((locale) => (
            <li><a href={localizedUrl('/', locale)} lang={locale} hreflang={locale} aria-current={locale === lang ? 'true' : undefined}>{languageNames[locale]}</a></li>
          ))}
        </ul>
      </details>
      <button class="nav-link theme-toggle" type="button" data-theme-toggle aria-label={t('header.themeDark', lang)}>
        <svg class="icon-moon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M15.5 12.6A6.5 6.5 0 0 1 7.4 4.5a6.5 6.5 0 1 0 8.1 8.1Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
        <svg class="icon-sun" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="3.6" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10 1.8v2.2M10 16v2.2M1.8 10H4M16 10h2.2M4.2 4.2l1.6 1.6M14.2 14.2l1.6 1.6M4.2 15.8l1.6-1.6M14.2 5.8l1.6-1.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
    </nav>
  </div>
</header>
