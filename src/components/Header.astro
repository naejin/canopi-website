---
import { t, locales, languageNames, localizedUrl, pageUrl, consortiumPath, type Locale, type PagePath } from '../i18n/utils';
import { DOCS_URL, discordUrl } from '../data/site';
import { guidesPath } from '../i18n/guides';
// path: the page within a locale, so the language menu leads to the same page in another language.
// alternates: the locales the page exists in; the menu sends the others to the English page.
// current: the section the page belongs to, marked in the navigation.
// From 640px the links sit inline; below, one Menu panel holds every link, so nothing is hidden by width.
// The consortium tool is one short word inline ("Consortium", « Guilde »), measured to fit at 640px in
// every locale, and its full name ("Design a consortium") in the Menu panel.
interface Props { lang: Locale; path?: PagePath; alternates?: readonly Locale[]; current?: 'guides' | 'books' | 'consortium'; }
const { lang, path = '/', alternates = locales, current } = Astro.props;
const menuTarget = (locale: Locale): Locale => (alternates.includes(locale) ? locale : 'en');
const guides = guidesPath(lang);
const books = localizedUrl('/bibliography/', lang);
const consortium = consortiumPath(lang);
const page = (section: 'guides' | 'books' | 'consortium') => (current === section ? 'page' : undefined);
---
<a class="skip-link" href="#main">{t('header.skip', lang)}</a>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={localizedUrl('/', lang)} aria-label={t('header.home', lang)}>
      <img src="/canopi-logo.svg" width="36" height="36" alt="" />
      <span>Canopi</span>
    </a>
    <nav class="header-nav" aria-label={t('header.navigation', lang)}>
      <div class="nav-inline">
        <a class="nav-link" href={guides} aria-current={page('guides')}>{t('header.guides', lang)}</a>
        <a class="nav-link" href={books} aria-current={page('books')}>{t('header.books', lang)}</a>
        <a class="nav-link" href={consortium} aria-current={page('consortium')}>{t('nav.consortium', lang)}</a>
        <button class="nav-link" type="button" data-open-donate>{t('header.donate', lang)}</button>
        <details class="lang-menu" data-lang-menu>
          <summary class="nav-link" aria-label={`${t('header.language', lang)}: ${languageNames[lang]}`}>{lang.toUpperCase()}</summary>
          <ul class="menu-panel" role="list">
            {locales.map((locale) => (
              <li><a href={pageUrl(path, menuTarget(locale))} lang={locale} hreflang={menuTarget(locale)} aria-current={locale === lang ? 'true' : undefined}>{languageNames[locale]}</a></li>
            ))}
          </ul>
        </details>
      </div>
      <details class="nav-menu" data-nav-menu>
        <summary class="nav-link">{t('header.menu', lang)}</summary>
        <div class="nav-panel">
          <ul class="nav-panel-links" role="list">
            <li><a href={guides} aria-current={page('guides')}>{t('header.guides', lang)}</a></li>
            <li><a href={books} aria-current={page('books')}>{t('header.books', lang)}</a></li>
            <li><a href={consortium} aria-current={page('consortium')}>{t('nav.consortium.menu', lang)}</a></li>
            <li><button type="button" data-open-donate>{t('header.donate', lang)}</button></li>
            <li><a href={discordUrl(lang)}>Discord</a></li>
            {DOCS_URL && <li><a href={DOCS_URL}>{t('header.docs', lang)}</a></li>}
            <li><a href={`${localizedUrl('/', lang)}#contact`}>{t('footer.contact', lang)}</a></li>
          </ul>
          <p class="nav-panel-label" id="nav-panel-languages">{t('header.language', lang)}</p>
          <ul class="nav-panel-langs" role="list" aria-labelledby="nav-panel-languages">
            {locales.map((locale) => (
              <li><a href={pageUrl(path, menuTarget(locale))} lang={locale} hreflang={menuTarget(locale)} aria-current={locale === lang ? 'true' : undefined}>{languageNames[locale]}</a></li>
            ))}
          </ul>
        </div>
      </details>
      <button class="nav-link theme-toggle" type="button" data-theme-toggle aria-label={t('header.themeDark', lang)}>
        <svg class="icon-moon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M15.5 12.6A6.5 6.5 0 0 1 7.4 4.5a6.5 6.5 0 1 0 8.1 8.1Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
        <svg class="icon-sun" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="3.6" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10 1.8v2.2M10 16v2.2M1.8 10H4M16 10h2.2M4.2 4.2l1.6 1.6M14.2 14.2l1.6 1.6M4.2 15.8l1.6-1.6M14.2 5.8l1.6-1.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
    </nav>
  </div>
</header>

<style is:global>
  /* Between 640 and 959px the inline row carries five links and the language menu in every locale
     (Russian and Japanese are the longest); tighter spacing keeps it on one line inside the page
     margins, measured at 640px in all 11 locales. From 960px the row keeps global.css. Global, not
     scoped, so the header's markup stays free of data-astro-cid attributes. */
  @media (min-width: 640px) and (max-width: 959px) {
    .site-header .header-inner { gap: 8px; }
    .site-header .header-nav, .site-header .nav-inline { gap: 2px; }
    .site-header .nav-link { padding: 0 6px; }
    .site-header .theme-toggle { padding: 0; }
  }
</style>
