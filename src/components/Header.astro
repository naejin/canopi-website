---
import { t, locales, languageNames, localizedUrl, type Locale } from '../i18n/utils';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const discordUrl = lang === 'fr' ? 'https://discord.gg/7wq9HsBdsc' : 'https://discord.gg/k7bsyjD9b8';
---
<a class="skip" href="#main">{t('header.skip', lang)}</a>
<header class="wrap">
  <a class="brand" href={localizedUrl('/', lang)} aria-label={t('header.home', lang)}><img src="/canopi-logo.svg" width="36" height="36" alt="" />Canopi</a>
  <nav aria-label={t('header.navigation', lang)}>
    <a href="https://liberapay.com/Canopi/donate">{t('header.donate', lang)}</a>
    <a class="community-link" href={discordUrl}>Discord</a>
    <details class="lang-switcher" data-lang-switcher>
      <summary aria-label={t('header.language', lang)}>{lang.toUpperCase()}</summary>
      <div class="lang-menu">
        {locales.map(locale => (<a href={localizedUrl('/', locale)} lang={locale} aria-current={locale === lang ? 'page' : undefined}>{languageNames[locale]}</a>))}
      </div>
    </details>
    <button data-theme-toggle data-dark-label={t('header.darkLabel', lang)} data-light-label={t('header.lightLabel', lang)} data-dark-aria={t('header.themeDark', lang)} data-light-aria={t('header.themeLight', lang)} aria-label={t('header.themeDark', lang)}>
      <span class="theme-label">{t('header.darkLabel', lang)}</span><span class="theme-symbol" aria-hidden="true">☾</span>
    </button>
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (toggle) {
    const updateLabel = () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      toggle.setAttribute('aria-label', (dark ? toggle.dataset.lightAria : toggle.dataset.darkAria)!);
      toggle.querySelector('.theme-label')!.textContent = (dark ? toggle.dataset.lightLabel : toggle.dataset.darkLabel)!;
      toggle.querySelector('.theme-symbol')!.textContent = dark ? '☀' : '☾';
    };
    updateLabel();
    toggle.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('canopi-theme', next); } catch {}
      updateLabel();
    });
  }
  const switcher = document.querySelector<HTMLDetailsElement>('[data-lang-switcher]');
  document.addEventListener('click', event => {
    if (switcher && !switcher.contains(event.target as Node)) switcher.open = false;
  });
  switcher?.addEventListener('keydown', event => {
    if (event.key === 'Escape') { switcher.open = false; switcher.querySelector('summary')?.focus(); }
  });
</script>
