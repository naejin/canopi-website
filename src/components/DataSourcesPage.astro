---
// /data-sources/ for one locale: the sources Canopi uses and holds, each with its licence status
// (canopi-data's source_credits.tsv, when an installed export shipped it; internal rows never), then
// the TRY citation and every dataset row as TRY delivered it, as static HTML. Names, credit lines,
// the citation and the rows stay in their original language, so only the words around them are
// translated. Astro escapes all this text; a row is never written as markup.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import DonateDialog from './DonateDialog.astro';
import PageData from './PageData.astro';
import { tryReferences, tryDatasetCount } from '../data/try-references';
import { sourceCredits } from '../data/source-credits';
import { safeHref } from '../lib/safe-href.js';
import { TRY_CITATION, TRY_DOI, referenceParts } from '../lib/try-references';
import { t, type Locale } from '../i18n/utils';
interface Props { lang: Locale; }
const { lang } = Astro.props;
// The sentence each licence status shows; a confirmed licence names its licence.
const licenceWords: Record<string, string> = {
  confirmed: 'dataSources.credits.licence.confirmed',
  unconfirmed: 'dataSources.credits.licence.unconfirmed',
  permission: 'dataSources.credits.licence.permission',
  per_item: 'dataSources.credits.licence.per_item',
  terms: 'dataSources.credits.licence.terms',
};
const creditGroups = sourceCredits ? [
  { id: 'credits-used', title: t('dataSources.credits.used', lang), rows: sourceCredits.used },
  { id: 'credits-held', title: t('dataSources.credits.held', lang), rows: sourceCredits.held },
].filter((group) => group.rows.length) : [];
---
<Base title={`${t('dataSources.title', lang)} · Canopi`} description={t('dataSources.lede', lang)} lang={lang} path="/data-sources/">
  <Header lang={lang} path="/data-sources/" />
  <main id="main">
    <section class="section data-sources" aria-labelledby="data-sources-title">
      <div class="wrap">
        <header class="section-head">
          <h1 id="data-sources-title">{t('dataSources.title', lang)}</h1>
          <p>{t('dataSources.lede', lang)}</p>
        </header>
        {creditGroups.length > 0 && (
          <section class="credits" aria-labelledby="credits-title">
            <h2 id="credits-title">{t('dataSources.credits.title', lang)}</h2>
            <p class="credits-note">{t('dataSources.credits.lede', lang)}</p>
            {creditGroups.map((group) => (
              <>
                <h3 id={group.id}>{group.title}</h3>
                <ul class="credit-list" role="list" aria-labelledby={group.id}>
                  {group.rows.map((row) => {
                    const href = safeHref(row.url);
                    return (
                      <li class="credit-row">
                        <span class="credit-name" lang="und" translate="no">{href ? <a href={href} rel="noopener">{row.name}</a> : row.name}</span>
                        {row.credit && <span class="credit-line" lang="und" translate="no">{row.credit}</span>}
                        <span class="credit-licence">{t(licenceWords[row.licenceStatus], lang, { licence: row.licence })}</span>
                      </li>
                    );
                  })}
                </ul>
              </>
            ))}
          </section>
        )}
        <section class="try" aria-labelledby="try-title">
        <h2 id="try-title" lang="en" translate="no">TRY plant trait database</h2>
        <p class="try-citation" lang="en" translate="no">{TRY_CITATION} <a href={TRY_DOI} rel="noopener">{TRY_DOI}</a></p>
        <p class="try-guidelines">{t('dataSources.guidelines', lang)}</p>
        <h2 id="try-datasets">{t('dataSources.list.title', lang)}</h2>
        <p class="try-note">{t('dataSources.list.count', lang, { rows: String(tryReferences.length), datasets: String(tryDatasetCount) })}</p>
        <p class="try-note">{t('dataSources.list.lost', lang)} {t('dataSources.list.partial', lang)}</p>
        <ul class="try-list" role="list" lang="und" translate="no" aria-labelledby="try-datasets">
          {tryReferences.map((row) => (
            <li class="try-row"><span class="try-dataset">{row.dataset}</span><span class="try-custodian">{row.custodian}</span><span class="try-reference">{referenceParts(row.reference).map((part) => part.href ? <a href={part.href} rel="noopener">{part.text}</a> : part.text)}</span></li>
          ))}
        </ul>
        </section>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
  <DonateDialog lang={lang} />
  <PageData lang={lang} keys={[]} />
  <script>
    import { initChrome } from '../scripts/chrome.js';
    initChrome();
  </script>
</Base>
