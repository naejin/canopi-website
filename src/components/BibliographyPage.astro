---
// The whole bibliography for one locale; src/pages/bibliography.astro and src/pages/[lang]/bibliography.astro render it.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Bibliography from './Bibliography.astro';
import Footer from './Footer.astro';
import DonateDialog from './DonateDialog.astro';
import PageData from './PageData.astro';
import { t, type Locale } from '../i18n/utils';
interface Props { lang: Locale; }
const { lang } = Astro.props;
---
<Base title={`${t('bibliography.title', lang)} · Canopi`} description={t('bibliography.lede', lang)} lang={lang} path="/bibliography/">
  <Header lang={lang} path="/bibliography/" current="books" />
  <main id="main">
    <Bibliography lang={lang} full />
  </main>
  <Footer lang={lang} />
  <DonateDialog lang={lang} />
  <PageData lang={lang} keys={[]} />
  <script>
    import { initChrome } from '../scripts/chrome.js';
    initChrome();
  </script>
</Base>
