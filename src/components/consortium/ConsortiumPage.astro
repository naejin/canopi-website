---
// The consortium design tool (beta, v2): /palette/ and /<lang>/palette/ ("Plant palette"; the old /consortium/ paths 301 here, public/_redirects).
// Astro renders the static shell (design check A1): the head (title, beta badge, lede, the beta note),
// the noscript callout with its guide link, a loading line and the data release line. The tool is a
// Preact island, src/islands/consortium/main.ts, mounted from the page script into #ct-root; it reads
// #ct-data: every consortium.* key of the page language without its prefix, the release id, the
// installed database (url, sha256, bytes and the raw digest, checked by the island), the climates and the {plant uuid: photo} map, all from
// src/data/consortium-index.json (scripts/install-consortium.mjs; nothing at build time reads SQLite).
// Stream S4 owns this file after commit 0; it adds the Start data (`start`) and print.css.
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import DonateDialog from '../DonateDialog.astro';
import PageData from '../PageData.astro';
import { t, localizedUrl, consortiumPath, defaultLocale, type Locale } from '../../i18n/utils';
import en from '../../i18n/translations/en.json';
import { publishedGuides, slugOf } from '../../lib/guides';
import { consortiumGuides, explainGuide } from '../../data/consortium-guides';
import { climates } from '../../data/climates';
import { countryZones } from '../../lib/consortium/country-zones.ts';
import index from '../../data/consortium-index.json';
import { climatePageData } from '../../data/climate-page-data';
import { P, setStrings } from '../../islands/consortium/strings.ts';
import '../../styles/consortium/base.css';
import '../../styles/consortium/details.css';
import '../../styles/consortium/shell.css';
import '../../styles/consortium/print.css';
// P5 (commit 0): one stylesheet per stream, each owned by its stream (src/styles/consortium/p5/).
import '../../styles/consortium/p5/s5b.css';
import '../../styles/consortium/p5/s5c.css';
import '../../styles/consortium/p5/s5d.css';
import '../../styles/consortium/p5/s5e.css';
// PP-B (commit 0): the page-level stylesheets of the Plant palette, each owned by its stream
// (scripts/plan/pp-b-owners.json): the palette page (b2), Place (b1a), Your plants (b3). Page-level, so
// no stylesheet loads with a lazy chunk (A14).
import '../../styles/consortium/palette-page.css';
import '../../styles/consortium/place.css';
import '../../styles/consortium/plants.css';
// PP-C (commit 0): Find's stylesheet (c1), page-level for the same reason.
import '../../styles/consortium/find.css';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const tr = (key: string) => t('consortium.' + key, lang);

const prefix = 'consortium.';
const strings: Record<string, string> = {};
// consortium.block.s1…s4 only mark where each stream appends its keys; they never reach the page.
// The correction form's correction.* and the climate names (climate.<zone>) are site-wide keys the
// island asks for under their own names (H13).
for (const key of Object.keys(en)) {
  if (key.startsWith(prefix) && !key.startsWith('consortium.block.')) strings[key.slice(prefix.length)] = t(key, lang);
  else if (key.startsWith('correction.') || /^climate\.[a-z]+$/.test(key)) strings[key] = t(key, lang);
}

// Guides exist in en and fr; every other locale links the English guide (marked hreflang="en").
const guideLang = lang === 'fr' ? 'fr' : 'en';
const guides = await publishedGuides(guideLang);
const linkedGuides = new Set(Object.values(consortiumGuides).flat());
const food = guides.find((entry) => slugOf(entry) === explainGuide);
const guide = food ? { url: localizedUrl(`/guides/${explainGuide}/`, guideLang), lang: guideLang } : null;
const contact = localizedUrl('/', lang) + '#contact';
const db = index.files[0];
// The names file (src/data/consortium-index.json search_names, always named since PP-C 0b): its
// reference only, fetched by Find after first paint, never preloaded.
type NamesRef = { url: string; sha256: string; bytes: number; raw_sha256: string; raw_bytes: number };
const searchNames = (index as { search_names: NamesRef }).search_names;
const countryCodes = (c: Record<string, boolean>) => ({ checked: Object.keys(c).filter((k) => c[k]).join(' '), unchecked: Object.keys(c).filter((k) => !c[k]).join(' '), zones: zonesByCountry(Object.keys(c)) });
// Each country's time zones from Node's CLDR data (the same the browser's Intl.Locale has), so the
// island's country guess never asks the browser for all of them (store.zonesOfCountry; about 3.4 KB gzip).
function zonesByCountry(codes: string[]): Record<string, string> {
  return Object.fromEntries(codes.map((c) => [c, countryZones(c).join(' ')]).filter(([, z]) => z));
}
const data = {
  lang,
  strings,
  releaseId: index.release_id,
  db: { url: db.url, sha256: db.sha256, bytes: db.bytes, rawSha256: db.raw_sha256, rawBytes: db.raw_bytes },
  names: { url: searchNames.url, sha256: searchNames.sha256, bytes: searchNames.bytes, rawSha256: searchNames.raw_sha256, rawBytes: searchNames.raw_bytes },
  climates: index.climates.map((c) => c.toLowerCase()),
  // The known countries, those GRIIS checked and those it did not (space-separated ISO codes), so the
  // country line shows its final guess and "not checked" note in its first frame (N2 layout shift).
  countries: countryCodes(index.countries),
  images: index.images,
  guide,
  // The title of each guide the plant dialog links (data/consortium-guides.ts), in the guide language
  // (slug → title; views/details/Details.tsx).
  guideTitles: Object.fromEntries(guides.filter((e) => linkedGuides.has(slugOf(e))).map((e) => [slugOf(e), e.data.title])),
  // Start (stream S4): every site climate in the site's order with its label and three example
  // places (site-wide climate.* keys), the contact address for "Ask for this climate", and the
  // site's own URL for the print foot. Read by views/Start.tsx; nothing here is chosen.
  start: {
    // size: the plants on the climate's own list in the installed release (ClimateHand "its own list, N
    // plants"; 0: none of its own).
    zones: climates.map((id) => ({ id, label: t(`climate.${id}`, lang), places: t(`climate.${id}.places`, lang), size: ((index as { names?: Record<string, unknown[]> }).names?.[id[0].toUpperCase() + id.slice(1)] ?? []).length })),
    contact,
    site: new URL(consortiumPath(lang), 'https://projectcanopi.com').href,
  },
};
// #ct-climate (P5 commit 0): the canopi-climate base path and tile names per layer, for the location
// reader (S5b), read at build from the installed index (scripts/install-climate.mjs, run before every
// build). The index is git-ignored, so a glob, which finds nothing rather than failing when it is
// absent (null then); not node:fs, which the Cloudflare prerender (workerd) does not have. Its own
// script, so the strings stay apart.
const climateIndex = Object.values(import.meta.glob('../../data/climate-index.json', { eager: true, import: 'default' }))[0] ?? null;
const climate = climatePageData(climateIndex as Parameters<typeof climatePageData>[0]);
setStrings(strings, lang);
// copy-m2: the number of climates is the installed index's, read at build time. The Beta line sits in
// the foot (pf-c): the v14 head carries the steps, the title and the lede only.
const betaNote = P('betaNote', index.climates.length);
---
<Base title={`${tr('title')} · Canopi`} description={tr('description')} lang={lang} path={consortiumPath(defaultLocale)}>
  {/* Design check A2: the database (≤ 1 MB gzipped) starts downloading with the page; crossorigin
      so the island's same-origin fetch() reuses it. The island's chunks get modulepreload links
      after the build (astro.config.mjs). */}
  <link slot="head" rel="preload" href={db.url} as="fetch" crossorigin="anonymous" />
  <Header lang={lang} path={consortiumPath(defaultLocale)} current="consortium" />
  <main id="main" class="ct">
    <div class="wrap ct-wrap">
      <div class="tool-head" id="ct-head">
        {/* The three steps (v14 boards Place, SiteKiambu): static here, so they show before the island,
            and the island never renders them again (BC1): views/place/steps.tsx only shows step 2's
            button in place of its words once there is a palette, and marks the step. The palette step's
            own head hides them and the lede (shell.css, #ct-head[data-step]). */}
        <ol class="ct-steps" id="ct-steps" aria-label={tr('palette.stepsLabel')}>
          <li aria-current="step"><span class="ct-steps-n">1</span> {tr('palette.stepPlace')}</li>
          <li><span data-step-words><span class="ct-steps-n">2</span> {tr('palette.stepPalette')}</span><button type="button" class="link-button ct-link" data-step-palette hidden><span class="ct-steps-n">2</span> {tr('palette.stepPalette')}</button></li>
          <li><span class="ct-steps-n">3</span> {tr('palette.stepPlan')}</li>
        </ol>
        <div class="tool-head-row">
          <h1 class="tool-title">{tr('title')}</h1><span class="badge-beta">{tr('beta')}</span>
          <span class="tool-head-links"><a class="text-link" href={contact}>{tr('feedback')}</a> <a class="text-link" href={localizedUrl('/data-sources/', lang)}>{t('dataSources.title', lang)}</a></span>
        </div>
        <p class="tool-lede">{tr('place.lede')}</p>
      </div>
      <noscript>
        <div class="callout"><p>{tr('noscript')}</p>{guide && <p><a class="text-link" href={guide.url} hreflang={guide.lang !== lang ? guide.lang : undefined}>{tr('noscript.link')}</a></p>}</div>
      </noscript>
      {/* How the page opens, set before the first paint so nothing jumps when the island mounts:
          "link" for a share link (any fragment with v or a; one this tool cannot read says so on Place),
          "preset" for a guide's ?plant=&climate= (design check A5), else "start". The island reads the
          address itself; this only marks the head, and its step (R16): "palette" for a link, a guide or
          a palette saved on this device, so a return paints the palette head first. */}
      <script is:inline>(function () { try {
        var h = document.getElementById('ct-head');
        var hp = new URLSearchParams((location.hash || '').replace(/^#/, '')), q = new URLSearchParams(location.search);
        var opens = hp.has('v') || hp.has('a') ? 'link' : q.has('plant') && q.has('climate') ? 'preset' : 'start';
        h.dataset.opens = opens;
        var saved = null;
        try { saved = JSON.parse(localStorage.getItem('canopi-consortium') || 'null'); } catch (e) {}
        h.dataset.step = opens !== 'start' || (saved && saved.fragment) ? 'palette' : 'place';
      } catch (e) {} })();</script>
      <div id="ct-root" aria-busy="true"><p class="status-line">{tr('loadingTool')}</p></div>
      {/* The beta note and the release line apart (R1): one paragraph each. */}
      <p class="tool-release tool-beta">{betaNote}</p>
      <p class="tool-release">{tr('release').replace('{id}', index.release_id)}</p>
    </div>
  </main>
  <Footer lang={lang} />
  <DonateDialog lang={lang} />
  <PageData lang={lang} keys={[]} />
  <script type="application/json" id="ct-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
  <script type="application/json" id="ct-climate" set:html={JSON.stringify(climate)} />
  {/* m10: the header (theme, Donate, menus, climate) starts first and on its own, so a failure in
      the tool never takes the header down with it. */}
  <script>
    import { initChrome } from '../../scripts/chrome.js';
    initChrome();
    // The island's chunk did not arrive (offline, a deploy replaced it): the loading line would stay
    // forever, so it gives way to "the tool did not load" and Reload (pre-push review 3).
    import('../../islands/consortium/main.ts').catch(() => {
      const root = document.querySelector('#ct-root'); // a selector: the bare ids mark the island's chunk (scripts/built-modules.mjs)
      if (!root) return;
      let words: Record<string, string> = {};
      try { words = JSON.parse(document.querySelector('#ct-data')?.textContent ?? '{}').strings ?? {}; } catch { /* the defaults below */ }
      const box = document.createElement('div');
      box.className = 'callout ct-load-failed';
      box.setAttribute('role', 'alert');
      box.dataset.loadError = 'island';
      const text = document.createElement('p');
      text.textContent = words['load.toolFailed'] ?? 'The tool did not load.';
      const reload = document.createElement('button');
      reload.type = 'button';
      reload.className = 'button button-primary';
      reload.textContent = words['load.reload'] ?? 'Reload';
      reload.addEventListener('click', () => location.reload());
      const row = document.createElement('p');
      row.appendChild(reload);
      box.appendChild(text);
      box.appendChild(row);
      root.removeAttribute('aria-busy');
      root.replaceChildren(box);
    });
  </script>
</Base>
