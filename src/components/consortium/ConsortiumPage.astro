---
// The consortium design tool (beta, v2): /consortium/ and /<lang>/consortium/.
// Astro renders the static shell (design check A1): the head (title, beta badge, lede, the beta note),
// the noscript callout with its guide link, a loading line and the data release line. The tool is a
// Preact island, src/islands/consortium/main.ts, mounted from the page script into #ct-root; it reads
// #ct-data: every consortium.* key of the page language without its prefix, the release id, the
// installed database (url, sha256, bytes and the raw digest, checked by the island), the climates and the {plant uuid: photo} map, all from
// src/data/consortium-index.json (scripts/install-consortium.mjs; nothing at build time reads SQLite).
// Stream S4 owns this file after commit 0.
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import DonateDialog from '../DonateDialog.astro';
import PageData from '../PageData.astro';
import { t, localizedUrl, type Locale } from '../../i18n/utils';
import en from '../../i18n/translations/en.json';
import { publishedGuides, slugOf } from '../../lib/guides';
import { explainGuide } from '../../data/consortium-guides';
import index from '../../data/consortium-index.json';
import { P, setStrings } from '../../islands/consortium/strings.ts';
import '../../styles/consortium/base.css';
import '../../styles/consortium/matrix.css';
import '../../styles/consortium/details.css';
import '../../styles/consortium/shell.css';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const tr = (key: string) => t('consortium.' + key, lang);

const prefix = 'consortium.';
const strings: Record<string, string> = {};
for (const key of Object.keys(en)) if (key.startsWith(prefix)) strings[key.slice(prefix.length)] = t(key, lang);

// Guides exist in en and fr; every other locale links the English guide (marked hreflang="en").
const guideLang = lang === 'fr' ? 'fr' : 'en';
const food = (await publishedGuides(guideLang)).find((entry) => slugOf(entry) === explainGuide);
const guide = food ? { url: localizedUrl(`/guides/${explainGuide}/`, guideLang), lang: guideLang } : null;
const contact = localizedUrl('/', lang) + '#contact';
const db = index.files[0];
const data = {
  lang,
  strings,
  releaseId: index.release_id,
  db: { url: db.url, sha256: db.sha256, bytes: db.bytes, rawSha256: db.raw_sha256, rawBytes: db.raw_bytes },
  climates: index.climates.map((c) => c.toLowerCase()),
  images: index.images,
  guide,
};
// copy-m2: the number of climates is the installed index's, read at build time.
setStrings(strings, lang);
const betaNote = P('betaNote', index.climates.length);
---
<Base title={`${tr('title')} · Canopi`} description={tr('description')} lang={lang} path="/consortium/">
  {/* Design check A2: the database (≤ 1 MB gzipped) starts downloading with the page; crossorigin
      so the island's same-origin fetch() reuses it. The island's chunks get modulepreload links
      after the build (astro.config.mjs). */}
  <link slot="head" rel="preload" href={db.url} as="fetch" crossorigin="anonymous" />
  <Header lang={lang} path="/consortium/" current="consortium" />
  <main id="main" class="ct">
    <div class="wrap ct-wrap">
      <div class="tool-head" id="ct-head">
        <div class="tool-head-row"><h1 class="tool-title">{tr('title')}</h1><span class="badge-beta">{tr('beta')}</span></div>
        <p class="tool-lede">{t('home.consortium.lede', lang)}</p>
        <p class="tool-meta">{betaNote} <a class="text-link" href={contact}>{tr('feedback')}</a> <a class="text-link" href={localizedUrl('/data-sources/', lang)}>{t('dataSources.title', lang)}</a></p>
      </div>
      <noscript>
        <div class="callout"><p>{tr('noscript')}</p>{guide && <p><a class="text-link" href={guide.url} hreflang={guide.lang !== lang ? guide.lang : undefined}>{tr('noscript.link')}</a></p>}</div>
      </noscript>
      {/* How the page opens, set before the first paint so nothing jumps when the island mounts:
          "link" for a share link (#v=4…), "preset" for a guide's ?plant=&climate= (design check A5),
          else "start". The island reads the address itself; this only marks the head. */}
      <script is:inline>(function () { try {
        var h = document.getElementById('ct-head');
        var hp = new URLSearchParams((location.hash || '').replace(/^#/, '')), q = new URLSearchParams(location.search);
        var opens = hp.get('v') === '4' ? 'link' : q.has('plant') && q.has('climate') ? 'preset' : 'start';
        h.dataset.opens = opens;
      } catch (e) {} })();</script>
      <div id="ct-root" aria-busy="true"><p class="status-line">{tr('loadingTool')}</p></div>
      <p class="tool-release">{tr('release').replace('{id}', index.release_id)}</p>
    </div>
  </main>
  <Footer lang={lang} />
  <DonateDialog lang={lang} />
  <PageData lang={lang} keys={[]} />
  <script type="application/json" id="ct-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
  {/* m10: the header (theme, Donate, menus, climate) starts first and on its own, so a failure in
      the tool never takes the header down with it. */}
  <script>
    import { initChrome } from '../../scripts/chrome.js';
    initChrome();
    import('../../islands/consortium/main.ts');
  </script>
</Base>
