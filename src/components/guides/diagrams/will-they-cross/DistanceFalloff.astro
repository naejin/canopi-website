---
// Will they cross?: Lofthouse's rule of thumb that crossing falls with the square of the distance,
// drawn to scale. A flowering plant on the left; dots at 1, 2, 4 and 10 times a starting distance,
// each dot's area matching its share of crosses (1, 1/4, 1/16, 1/100). No curve and no slider: the
// rule is his intuition, not a measurement. The two axis labels are HTML (they wrap on phones);
// labels and alt text come from the MDX.
interface Props { distance: string; share: string; alt: string; }
const { distance, share, alt } = Astro.props;
const X0 = 30, UNIT = 27, Y = 50, R = 11;
const steps = [
  { times: 1, label: '1' },
  { times: 2, label: '¼' },
  { times: 4, label: '1/16' },
  { times: 10, label: '1/100' },
].map((s) => ({ ...s, x: X0 + s.times * UNIT, r: Math.max(1.4, Math.round((R / s.times) * 10) / 10) }));
---
<div class="guide-falloff">
  <p class="guide-falloff-key">{distance} →</p>
  <svg viewBox="0 0 320 92" role="img" aria-label={alt}>
    <path d={`M${X0} 90C${X0 + 1} 74 ${X0 - 1} 58 ${X0} 40`} class="guide-falloff-stem" />
    <path d={`M${X0} 72q-12 -4 -14 -14q11 1 14 10z`} class="guide-falloff-leaf" />
    <path d={`M${X0} 64q12 -4 14 -14q-11 1 -14 10z`} class="guide-falloff-leaf" />
    {[0, 72, 144, 216, 288].map((a) => <ellipse cx={X0} cy="22" rx="4.5" ry="8" transform={`rotate(${a} ${X0} 30)`} class="guide-falloff-petal" />)}
    <circle cx={X0} cy="30" r="3.5" class="guide-falloff-dot" />
    <line x1={X0 + 12} y1={Y} x2="314" y2={Y} class="guide-falloff-axis" />
    {steps.map((s) => (
      <>
        <text x={s.x} y={Y - 17} text-anchor="middle" class="guide-falloff-times">{s.times}×</text>
        <circle cx={s.x} cy={Y} r={s.r} class="guide-falloff-dot" />
        <text x={s.x} y={Y + 31} text-anchor={s.times === 10 ? 'end' : 'middle'} dx={s.times === 10 ? 8 : 0} class="guide-falloff-share">{s.label}</text>
      </>
    ))}
  </svg>
  <p class="guide-falloff-key">{share}</p>
</div>

<style>
  .guide-falloff { display: grid; gap: 0.2rem; max-width: 36rem; }
  .guide-falloff svg { width: 100%; }
  .guide-falloff-key { margin: 0; padding-left: 15%; font-size: 0.85rem; color: var(--text-secondary); line-height: 1.3; }
  .guide-falloff-stem { fill: none; stroke: var(--leaf); stroke-width: 3; stroke-linecap: round; }
  .guide-falloff-leaf { fill: var(--leaf); }
  .guide-falloff-petal { fill: var(--petal); }
  .guide-falloff-dot { fill: var(--anther); }
  .guide-falloff-axis { stroke: var(--border-strong); stroke-width: 1; stroke-dasharray: 2 3; }
  .guide-falloff .guide-falloff-times { font-size: 12px; fill: var(--text-muted); }
  .guide-falloff .guide-falloff-share { font-size: 14px; font-weight: 600; fill: var(--text); }
</style>
