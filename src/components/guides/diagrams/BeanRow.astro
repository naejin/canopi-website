---
// The hero's row of beans from one landrace jar, different for every guide (seeded by its slug).
import { rng, seedOf, type Bean } from '../../../lib/svg';
import BeanG from './Bean.astro';
interface Props { seed: string; }
const r = rng(seedOf(Astro.props.seed));
const beans: Bean[] = Array.from({ length: 22 }, (_, i) => {
  const c = 1 + Math.floor(r() * 6);
  return { x: 18 + i * 28.5, y: 32 + (r() - 0.5) * 10, c, c2: r() < 0.22 ? 1 + Math.floor(r() * 6) : 0, s: 1.25 + r() * 0.6, r: (r() - 0.5) * 80, speck: r() < 0.35 };
});
---
<svg class="guide-specimens" viewBox="0 0 640 64" aria-hidden="true" focusable="false">{beans.map((b) => <BeanG bean={b} />)}</svg>
