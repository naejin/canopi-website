---
// Squash guide: the three squash species side by side, a drawn fruit over each column, then one fact
// per row (its label on a full-width line above the three cells, so the chart stays three columns
// wide on a phone). Every word comes from the MDX, so English and French each pass their own.
import { fruits, type Species } from './fruit-shapes';
interface Column { species: Species; name: string; latin: string; alt: string }
interface Row { label: string; cells: [string, string, string] }
interface Props { title: string; columns: Column[]; rows: Row[]; note?: string }
const { title, columns, rows, note } = Astro.props;
if (columns.length !== 3) throw new Error('<SquashSpecies>: three columns, one per species');
for (const c of columns) if (!(c.species in fruits)) throw new Error(`<SquashSpecies>: unknown species "${c.species}"`);
for (const r of rows) if (r.cells.length !== 3) throw new Error(`<SquashSpecies>: row "${r.label}" needs three cells`);
---
<figure class="guide-figure guide-sq">
  <table class="guide-sq-table">
    <caption class="guide-figure-title">{title}</caption>
    <thead>
      <tr>
        {columns.map((c) => {
          const f = fruits[c.species];
          return (
            <th scope="col" id={`guide-sq-${c.species}`}>
              <svg viewBox="0 0 120 80" role="img" aria-label={c.alt}>
                <path d={f.stem} class="guide-sq-stem" />
                <path d={f.body} class={`${f.cls} guide-sq-body`} />
                {f.lines.map((d) => <path d={d} class="guide-fruit-stripe" />)}
                {f.extra && <path d={f.extra} class="guide-fruit-stripe" />}
              </svg>
              <span class="guide-sq-name">{c.name}</span>
              <span class="guide-sq-latin">{c.latin}</span>
            </th>
          );
        })}
      </tr>
    </thead>
    <tbody>
      {rows.map((r, i) => (
        <>
          <tr class="guide-sq-label-row"><th colspan="3" scope="colgroup" id={`guide-sq-row-${i}`}>{r.label}</th></tr>
          <tr>{r.cells.map((cell, k) => <td headers={`guide-sq-${columns[k].species} guide-sq-row-${i}`}>{cell}</td>)}</tr>
        </>
      ))}
    </tbody>
  </table>
  {note && <figcaption class="guide-figure-caption">{note}</figcaption>}
</figure>

<style>
  .guide-sq { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 0.9rem 1rem 0.8rem; }
  .guide-sq-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 0.92rem; line-height: 1.4; }
  .guide-sq-table caption { text-align: left; padding-bottom: 0.4rem; }
  .guide-sq-table thead th { vertical-align: bottom; text-align: center; padding: 0 0.35rem 0.5rem; font-weight: 600; }
  .guide-sq-table thead svg { width: 100%; max-width: 6.5rem; margin: 0 auto 0.3rem; }
  .guide-sq-name { display: block; font-family: var(--font-display); font-size: 1.02rem; }
  .guide-sq-latin { display: block; font-size: 0.78rem; color: var(--text-muted); font-weight: 400; }
  .guide-sq-label-row th { text-align: left; padding: 0.55rem 0.35rem 0.15rem; border-top: 1px solid var(--border); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); font-weight: 600; }
  .guide-sq-table td { vertical-align: top; padding: 0 0.35rem 0.5rem; color: var(--text-secondary); hyphens: auto; overflow-wrap: break-word; }
  .guide-sq-stem { fill: var(--leaf); stroke: var(--leaf); stroke-width: 2; stroke-linejoin: round; }
  .guide-sq-body { stroke: var(--border-strong); stroke-width: 0.8; }
  @media (max-width: 639px) {
    .guide-sq { padding-inline: 0.6rem; }
    .guide-sq-table { font-size: 0.85rem; }
  }
</style>
