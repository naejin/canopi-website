---
// A population followed over the years: many varieties sown, most fail, survivors cross, the
// population keeps varying. labels: four { when, text } to replace the default captions.
import { grid, rng } from '../../../lib/svg';
import { gt, guideLangOf } from '../../../i18n/guides';
import BeanG from './Bean.astro';
interface Props { labels?: { when: string; text: string; alt?: string }[]; note?: string | false; }
const lang = guideLangOf(Astro.currentLocale);
const { labels, note } = Astro.props;
const r = rng(42);
const base = Array.from({ length: 24 }, (_, i) => ({ c: 1 + ((i * 5) % 6), speck: r() < 0.25, rot: (r() - 0.5) * 70 }));
const survivors = new Set([3, 8, 13, 17, 22]);
const palette = [...survivors].map((i) => base[i].c);
const stages = [0, 1, 2, 3].map((st) => {
  const rr = rng(100 + st * 13);
  const beans = grid(6, 4, 20, 22, 24, 23, rr, 5).map(([x, y], i) => {
    if (st === 0) return { x, y, c: base[i].c, speck: base[i].speck, r: base[i].rot };
    if (st === 1) return { x, y, c: base[i].c, speck: base[i].speck, r: base[i].rot, gone: !survivors.has(i) };
    const a = palette[Math.floor(rr() * palette.length)];
    const b = palette[Math.floor(rr() * palette.length)];
    if (st === 3 && i === 9) return { x, y, c: 5, speck: true, r: 20 };
    return { x, y, c: a, c2: rr() < (st === 2 ? 0.5 : 0.35) ? b : 0, r: (rr() - 0.5) * 60, s: 0.9 + rr() * 0.2 };
  });
  return {
    beans,
    when: labels?.[st]?.when ?? gt(`years.${st}.when`, lang),
    text: labels?.[st]?.text ?? gt(`years.${st}.do`, lang),
    alt: labels?.[st]?.alt ?? gt(`years.${st}.alt`, lang),
  };
});
const key = note === false ? null : note ?? (labels ? null : gt('years.key', lang));
---
<figure class="guide-figure guide-years">
  <ol class="guide-stages">
    {stages.map((stage) => (
      <li class="guide-stage">
        <svg viewBox="0 0 160 112" role="img" aria-label={stage.alt}><rect x="2" y="2" width="156" height="108" rx="7" class="guide-paper" />{stage.beans.map((b) => <BeanG bean={b} />)}</svg>
        <span class="guide-stage-when">{stage.when}</span>
        <span class="guide-stage-do">{stage.text}</span>
      </li>
    ))}
  </ol>
  {key && <figcaption class="guide-small">{key}</figcaption>}
</figure>
