---
// Homes for pollinators: one garden cross-section, left to right. Bare sunny ground with two
// tunnels and their sealed cells (bees that dig); a dead stem cut away to show a row of cells (a
// hollow stem); a fallen log with beetle holes (old wood); a tight pile of prunings (brush pile);
// whole fallen leaves with a curled caterpillar on top and a bumble bee queen in a hollow beneath
// (leaf litter); a flat stone under the sun with a basking butterfly (warming stone). Soil in soil
// tokens, stems, wood and leaves in plant tokens, insects in ink and ochre. Labels alternate above
// and below the drawing so each has room to wrap. No sizes or counts: the book gives none.
import { leafPath, r1, rng, seedOf, wrap } from '../../../../lib/svg';
interface Labels { dig: string; stem: string; wood: string; brush: string; litter: string; stone: string; }
interface Props { labels: Labels; alt: string; }
const { labels, alt } = Astro.props;
const W = 480, G = 172, SB = 238; // width, ground line, bottom of the soil
const rand = rng(seedOf('nest-sites'));
// Soil grains, kept out of the tunnels' corner so the burrows read clearly.
const grains = Array.from({ length: 46 }, () => ({ x: r1(4 + rand() * (W - 8)), y: r1(G + 8 + rand() * (SB - G - 14)), r: r1(0.9 + rand() * 1.3) }))
  .filter((g) => !(g.x < 84 && g.y < 226));
// Bees that dig: two spoil mounds and two tunnels, each ending in sealed cells.
const mounds = [26, 60].map((x) => `M${x - 9} ${G}Q${x} ${G - 9} ${x + 9} ${G}Z`);
const tunnels = [
  `M26 ${G}C24 ${G + 14} 16 ${G + 22} 18 ${G + 38}`,
  `M60 ${G}C62 ${G + 16} 70 ${G + 28} 66 ${G + 46}`,
  `M20 ${G + 26}q12 4 16 14`,
  `M64 ${G + 30}q-12 6 -14 16`,
];
const cells = [[18, G + 42], [37, G + 44], [66, G + 50], [49, G + 50]];
// A bee: ochre body with ink bands, pale wings, at x,y, turned by `turn` degrees.
const bee = (x: number, y: number, turn = 0, s = 1) => ({ t: `translate(${x} ${y}) rotate(${turn}) scale(${s})` });
const bees = [bee(44, 142, -18, 1.4), bee(306, 120, 24, 1.3)];
// The hollow stem: a dead stem cut away along its length to show a row of cells.
const STEM = 118, ST = 64;
const stemCells = [0, 1, 2, 3].map((i) => ST + 22 + i * 18);
// Old wood: a log lying on the ground, its cut end on the right, beetle holes along the top.
const LX0 = 160, LX1 = 238, LY = G - 26;
const holes = [[174, LY + 9], [190, LY + 15], [205, LY + 8], [214, LY + 18], [182, LY + 20]];
// The brush pile: prunings crossed into a tight dome.
const sticks = Array.from({ length: 34 }, (_, i) => {
  const a = Math.PI * (0.08 + 0.84 * rand());
  const cx = 286 + (rand() - 0.5) * 48, cy = G - 6 - rand() * 30 * Math.sin(a);
  const len = 26 + rand() * 22;
  const dx = Math.cos(a + (rand() - 0.5)) * len / 2, dy = Math.sin(a + (rand() - 0.5)) * len / 2 * 0.5;
  return { d: `M${r1(cx - dx)} ${r1(Math.min(G, cy - dy))}L${r1(cx + dx)} ${r1(Math.min(G, cy + dy))}`, cls: i % 3 ? 'guide-ns-twig' : 'guide-ns-twig-dark' };
});
// Leaf litter: whole leaves heaped low on the ground, autumn colours.
const tones = ['guide-ns-leaf-brown', 'guide-ns-leaf-ochre', 'guide-ns-leaf-gold'];
const leaves = Array.from({ length: 20 }, (_, i) => ({
  d: leafPath(14 + rand() * 6, r1(334 + rand() * 64), r1(G - 2 - rand() * 10), Math.round(rand() * 360)),
  cls: tones[i % 3],
}));
// The warming stone, with the sun above it.
const stone = `M414 ${G}C414 ${G - 12} 428 ${G - 18} 446 ${G - 18}C464 ${G - 18} 476 ${G - 10} 476 ${G}Z`;
const SUNX = 446, SUNY = 84;
const rays = Array.from({ length: 8 }, (_, i) => {
  const a = (i * Math.PI) / 4;
  return `M${r1(SUNX + Math.cos(a) * 14)} ${r1(SUNY + Math.sin(a) * 14)}L${r1(SUNX + Math.cos(a) * 20)} ${r1(SUNY + Math.sin(a) * 20)}`;
});
// Labels: 18px, 20 units apart; three above the drawing, three under the soil.
const lines = (text: string) => wrap(text, 14);
const top = [
  { x: 6, anchor: 'start', text: lines(labels.dig), lead: [40, 132] },
  { x: 199, anchor: 'middle', text: lines(labels.wood), lead: [199, LY - 4] },
  { x: 368, anchor: 'middle', text: lines(labels.litter), lead: [368, G - 18] },
];
const bottom = [
  { x: STEM, anchor: 'middle', text: lines(labels.stem), lead: [STEM, G + 2] },
  { x: 286, anchor: 'middle', text: lines(labels.brush), lead: [286, G + 2] },
  { x: 474, anchor: 'end', text: lines(labels.stone), lead: [446, G + 2] },
];
const topBase = 20;
const bottomBase = SB + 24;
---
<svg class="guide-ns" viewBox={`0 0 ${W} ${bottomBase + 20 + 6}`} role="img" aria-label={alt}>
  {/* Soil */}
  <rect x="0" y={G} width={W} height={SB - G} rx="3" class="guide-ns-soil" />
  {grains.map((g) => <circle cx={g.x} cy={g.y} r={g.r} class="guide-ns-grain" />)}
  {/* Bees that dig */}
  {mounds.map((d) => <path d={d} class="guide-ns-spoil" />)}
  {tunnels.map((d) => <path d={d} class="guide-ns-tunnel" />)}
  {cells.map(([x, y]) => <ellipse cx={x} cy={y} rx="5" ry="3.6" class="guide-ns-cell" />)}
  {/* Hollow stem: a second, whole stem beside it, with a seed head */}
  <path d={`M${STEM - 18} ${G}L${STEM - 20} ${ST + 20}`} class="guide-ns-stalk" />
  <circle cx={STEM - 20} cy={ST + 16} r="5" class="guide-ns-seedhead" />
  <rect x={STEM - 6} y={ST} width="12" height={G - ST} rx="2" class="guide-ns-stem" />
  <rect x={STEM - 3} y={ST + 10} width="6" height={stemCells[3] + 12 - ST - 10} rx="1.5" class="guide-ns-pith" />
  {stemCells.map((y) => <ellipse cx={STEM} cy={y} rx="2.4" ry="6" class="guide-ns-cell" />)}
  {stemCells.map((y) => <path d={`M${STEM - 3} ${y + 9}H${STEM + 3}`} class="guide-ns-wall" />)}
  <path d={`M${STEM - 6} ${ST}L${STEM + 6} ${ST - 5}V${ST + 2}H${STEM - 6}Z`} class="guide-ns-stem" />
  {/* Old wood */}
  <rect x={LX0} y={LY} width={LX1 - LX0} height={G - LY} rx="13" class="guide-ns-wood" />
  <ellipse cx={LX1 - 4} cy={LY + 13} rx="9" ry="13" class="guide-ns-endgrain" />
  <ellipse cx={LX1 - 4} cy={LY + 13} rx="4.5" ry="7" class="guide-ns-ring" />
  {holes.map(([x, y]) => <circle cx={x} cy={y} r="2.2" class="guide-ns-hole" />)}
  <path d={`M178 ${LY + 4}q6 6 12 2t10 4M196 ${LY + 22}q6 -4 10 0`} class="guide-ns-gallery" />
  {/* Brush pile */}
  {sticks.map((s) => <path d={s.d} class={s.cls} />)}
  {/* Leaf litter, a bumble bee queen in a hollow under it, a caterpillar on top */}
  <ellipse cx="362" cy={G + 9} rx="14" ry="8" class="guide-ns-hollow" />
  {leaves.map((l) => <path d={l.d} class={l.cls} />)}
  <g transform={`translate(362 ${G + 9}) scale(1.15)`}>
    <ellipse cx="0" cy="0" rx="8" ry="5" class="guide-ns-body" />
    <path d="M-2.5 -4.6V4.6M2.5 -4.6V4.6" class="guide-ns-band" />
    <path d="M-1 -4C-4 -9 2 -11 3 -5Z" class="guide-ns-wing" />
  </g>
  <path d={`M386 ${G - 16}a7 7 0 1 1 9 6`} class="guide-ns-caterpillar" />
  <path d={`M386 ${G - 16}a7 7 0 1 1 9 6`} class="guide-ns-caterpillar-spots" />
  {/* Warming stone and a basking butterfly */}
  <path d={stone} class="guide-ns-stone" />
  <g class="guide-ns-sun">
    <circle cx={SUNX} cy={SUNY} r="9" />
    {rays.map((d) => <path d={d} />)}
  </g>
  <g transform={`translate(446 ${G - 30})`}>
    <path d="M-1 -2C-8 -14 -20 -14 -19 -5C-18 1 -8 2 -1 0Z M1 -2C8 -14 20 -14 19 -5C18 1 8 2 1 0Z" class="guide-ns-bwing" />
    <path d="M-1 1C-7 2 -14 6 -11 11C-8 14 -3 8 -1 3Z M1 1C7 2 14 6 11 11C8 14 3 8 1 3Z" class="guide-ns-bwing" />
    <circle cx="-11" cy="-6" r="2.2" class="guide-ns-bspot" /><circle cx="11" cy="-6" r="2.2" class="guide-ns-bspot" />
    <path d="M0 -4V9" class="guide-ns-bbody" />
    <path d="M-0.5 -4Q-3 -10 -5 -12M0.5 -4Q3 -10 5 -12" class="guide-ns-antenna" />
  </g>
  {/* Flying bees */}
  {bees.map((b) => (
    <g transform={b.t}>
      <path d="M-2 -3.6C-6 -11 3 -12 3 -4Z M1 -3.6C2 -10 10 -9 6 -3Z" class="guide-ns-wing" />
      <ellipse cx="0" cy="0" rx="7" ry="4.2" class="guide-ns-body" />
      <path d="M-2 -4V4M2 -4V4" class="guide-ns-band" />
    </g>
  ))}
  <line x1="0" y1={G} x2={W} y2={G} class="guide-ns-ground" />
  {/* Labels and their leaders */}
  {top.map((l) => (
    <>
      <line x1={l.lead[0]} y1={topBase + (l.text.length - 1) * 20 + 6} x2={l.lead[0]} y2={l.lead[1]} class="guide-ns-lead" />
      <text x={l.x} y={topBase} text-anchor={l.anchor} class="guide-ns-label">
        {l.text.map((t, i) => <tspan x={l.x} dy={i ? 20 : 0}>{t}</tspan>)}
      </text>
    </>
  ))}
  {bottom.map((l) => (
    <>
      <line x1={l.lead[0]} y1={bottomBase - 14} x2={l.lead[0]} y2={l.lead[1]} class="guide-ns-lead guide-ns-lead-soil" />
      <text x={l.x} y={bottomBase} text-anchor={l.anchor} class="guide-ns-label">
        {l.text.map((t, i) => <tspan x={l.x} dy={i ? 20 : 0}>{t}</tspan>)}
      </text>
    </>
  ))}
</svg>

<style>
  .guide-ns { display: block; width: 100%; max-width: 40rem; height: auto; margin: 0 auto; }
  .guide-ns-soil { fill: var(--soil-1); }
  .guide-ns-grain { fill: var(--soil-grain); opacity: 0.7; }
  .guide-ns-spoil { fill: var(--soil-3); }
  .guide-ns-tunnel { fill: none; stroke: var(--soil-2); stroke-width: 5; stroke-linecap: round; }
  .guide-ns-cell { fill: var(--accent); stroke: var(--text); stroke-width: 0.8; }
  .guide-ns-ground { stroke: var(--border-strong); stroke-width: 1.4; }
  .guide-ns-stem { fill: var(--leaf-brown); }
  .guide-ns-pith { fill: var(--seed-3); }
  .guide-ns-wall { stroke: var(--leaf-brown); stroke-width: 1.4; }
  .guide-ns-stalk { fill: none; stroke: var(--leaf-brown); stroke-width: 3; stroke-linecap: round; }
  .guide-ns-seedhead { fill: var(--leaf-ochre); }
  .guide-ns-wood { fill: var(--seed-1); }
  .guide-ns-endgrain { fill: var(--seed-3); stroke: var(--seed-1); stroke-width: 1.2; }
  .guide-ns-ring { fill: none; stroke: var(--seed-1); stroke-width: 1; }
  .guide-ns-hole { fill: var(--seed-2); }
  .guide-ns-gallery { fill: none; stroke: var(--seed-2); stroke-width: 1.2; stroke-linecap: round; }
  .guide-ns-twig { stroke: var(--leaf-brown); stroke-width: 2.6; stroke-linecap: round; }
  .guide-ns-twig-dark { stroke: var(--seed-1); stroke-width: 2.2; stroke-linecap: round; }
  .guide-ns-leaf-brown { fill: var(--leaf-brown); } .guide-ns-leaf-ochre { fill: var(--leaf-ochre); } .guide-ns-leaf-gold { fill: var(--leaf-gold); }
  .guide-ns-hollow { fill: var(--soil-2); }
  .guide-ns-body { fill: var(--accent); stroke: var(--text); stroke-width: 0.8; }
  .guide-ns-band { stroke: var(--text); stroke-width: 1.6; }
  .guide-ns-wing { fill: var(--surface); fill-opacity: 0.85; stroke: var(--text-muted); stroke-width: 0.8; }
  .guide-ns-caterpillar { fill: none; stroke: var(--text-secondary); stroke-width: 5.5; stroke-linecap: round; }
  .guide-ns-caterpillar-spots { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 0.1 4.4; }
  .guide-ns-stone { fill: var(--text-muted); fill-opacity: 0.35; stroke: var(--text-secondary); stroke-width: 1.4; }
  .guide-ns-sun circle { fill: none; stroke: var(--accent); stroke-width: 2; }
  .guide-ns-sun path { stroke: var(--accent); stroke-width: 2; stroke-linecap: round; }
  .guide-ns-bwing { fill: var(--accent); stroke: var(--text); stroke-width: 0.9; }
  .guide-ns-bbody { stroke: var(--text); stroke-width: 2.6; stroke-linecap: round; }
  .guide-ns-bspot { fill: var(--text); }
  .guide-ns-antenna { fill: none; stroke: var(--text); stroke-width: 1; stroke-linecap: round; }
  .guide-ns-lead { stroke: var(--text-muted); stroke-width: 1; }
  .guide-ns-lead-soil { stroke: var(--soil-grain); }
  .guide-ns-label { font-family: var(--font-sans); font-size: 18px; fill: var(--text); }
</style>
