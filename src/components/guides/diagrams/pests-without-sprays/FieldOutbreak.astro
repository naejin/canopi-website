---
// Pests and diseases: one disease in two plantings, seen from above after it passed. Left: 36 plants of
// one colour (the same defences), nearly all grey and shrunken. Right: 36 plants in five colours (mixed
// defences), a few scattered ones grey. No figures are claimed: the counts only draw the idea. Names and
// notes are HTML under the plots; positions come from a seeded random, so every build is identical.
import { grid, rng, seedOf, shuffle } from '../../../../lib/svg';
interface Plot { name: string; note: string; }
interface Props { title: string; alt: string; plots: [Plot, Plot]; }
const { title, alt, plots } = Astro.props;
const locals = Astro.locals as { guideSvgs?: number };
const uid = `guide-outbreak-${(locals.guideSvgs = (locals.guideSvgs ?? 0) + 1)}`;
const rand = rng(seedOf('pests-without-sprays/outbreak'));
const left = grid(6, 6, 26, 26, 25, 22, rand, 6);
const right = grid(6, 6, 206, 26, 25, 22, rand, 6);
const leftLost = new Set(shuffle([...Array(36).keys()], rand).slice(0, 32));
const rightLost = new Set(shuffle([...Array(36).keys()], rand).slice(0, 5));
const colours = right.map((_, k) => 1 + ((k * 7 + Math.floor(rand() * 5)) % 5));
---
<div class="guide-outbreak">
  <svg viewBox="0 0 360 160" role="img" aria-labelledby={`${uid}-t`} aria-describedby={`${uid}-d`}>
    <title id={`${uid}-t`}>{title}</title>
    <desc id={`${uid}-d`}>{alt}</desc>
    <rect x="6" y="6" width="166" height="146" rx="6" class="guide-bed" />
    <rect x="188" y="6" width="166" height="146" rx="6" class="guide-bed" />
    {left.map(([x, y], k) => leftLost.has(k)
      ? <circle cx={x} cy={y} r="4" class="guide-outbreak-lost" />
      : <circle cx={x} cy={y} r="8" class="guide-outbreak-plant guide-outbreak-c6" />)}
    {right.map(([x, y], k) => rightLost.has(k)
      ? <circle cx={x} cy={y} r="4" class="guide-outbreak-lost" />
      : <circle cx={x} cy={y} r="8" class={`guide-outbreak-plant guide-outbreak-c${colours[k]}`} />)}
  </svg>
  <ul class="guide-outbreak-names">
    {plots.map((p) => <li><b>{p.name}</b><span>{p.note}</span></li>)}
  </ul>
</div>

<style>
  .guide-outbreak { display: grid; gap: 0.45rem; max-width: 30rem; }
  .guide-outbreak svg { width: 100%; height: auto; }
  .guide-outbreak-plant { stroke: var(--surface); stroke-width: 1.5; }
  .guide-outbreak-lost { fill: var(--border-strong); opacity: 0.55; }
  .guide-outbreak-c1 { fill: var(--seed-1); }
  .guide-outbreak-c2 { fill: var(--seed-3); }
  .guide-outbreak-c3 { fill: var(--seed-4); }
  .guide-outbreak-c4 { fill: var(--seed-5); }
  .guide-outbreak-c5 { fill: var(--leaf); }
  .guide-outbreak-c6 { fill: var(--leaf); }
  :global(.guide-body) .guide-outbreak-names { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; margin: 0; padding: 0; list-style: none; font-size: 0.88rem; line-height: 1.35; color: var(--text-secondary); }
  :global(.guide-body) .guide-outbreak-names li { display: grid; gap: 0.1rem; margin: 0; }
  .guide-outbreak-names b { color: var(--text); font-weight: 600; }
</style>
