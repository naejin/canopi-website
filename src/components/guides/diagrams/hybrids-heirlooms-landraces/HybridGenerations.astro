---
// Hybrids, heirlooms and landraces: why seed saved from an F1 hybrid "doesn't come true". Two unlike
// parent squash, a row of identical F1 fruits, then a row of F2 fruits that reshuffle the parents'
// shape and colour. Labels and alt text come from the MDX, so each language gets its own.
import { r1 } from '../../../../lib/svg';
interface Props { parents: string; f1: string; f2: string; alt: string; }
const { parents, f1, f2, alt } = Astro.props;

type Shape = 'round' | 'long' | 'oval';
type Tone = 'green' | 'orange' | 'fleck';
interface Fruit { x: number; y: number; shape: Shape; tone: Tone; size: number; }
const dims = (f: Fruit) => {
  const s = f.size;
  return f.shape === 'round' ? { rx: s, ry: s * 0.92 } : f.shape === 'long' ? { rx: s * 1.55, ry: s * 0.6 } : { rx: s * 1.15, ry: s * 0.85 };
};
// Flecks of the orange parent on a green fruit, at fixed spots so every build is identical.
const fleckSpots: [number, number][] = [[-0.55, -0.3], [-0.1, 0.35], [0.35, -0.4], [0.6, 0.2], [0.05, -0.05], [-0.4, 0.45]];
const draw = (f: Fruit) => {
  const { rx, ry } = dims(f);
  return {
    ...f, rx: r1(rx), ry: r1(ry),
    // A stem stub on top; ribs on the round and oval fruits.
    stem: `M${r1(f.x - rx * 0.1)} ${r1(f.y - ry + 1)}l${r1(-1.5)} ${r1(-Math.max(3, ry * 0.35))}`,
    ribs: f.shape === 'long' ? [] : [-0.45, 0.45].map((k) => `M${r1(f.x + rx * k)} ${r1(f.y - ry * 0.9)}Q${r1(f.x + rx * k * 1.25)} ${f.y} ${r1(f.x + rx * k)} ${r1(f.y + ry * 0.9)}`),
    flecks: f.tone === 'fleck' ? fleckSpots.map(([dx, dy]) => ({ cx: r1(f.x + dx * rx), cy: r1(f.y + dy * ry), r: r1(Math.max(1.3, f.size * 0.11)) })) : [],
  };
};
const parentRow = [draw({ x: 116, y: 50, shape: 'round', tone: 'green', size: 21 }), draw({ x: 214, y: 50, shape: 'long', tone: 'orange', size: 21 })];
const f1Row = [64, 112, 160, 208, 256].map((x) => draw({ x, y: 138, shape: 'oval', tone: 'fleck', size: 15 }));
const f2Kinds: [Shape, Tone, number][] = [
  ['round', 'green', 14], ['long', 'orange', 11], ['oval', 'fleck', 13], ['round', 'orange', 11],
  ['long', 'green', 11.5], ['oval', 'orange', 12], ['round', 'fleck', 14.5], ['long', 'fleck', 10.5],
];
const f2Row = f2Kinds.map(([shape, tone, size], i) => draw({ x: r1(24 + i * 38.9), y: 222, shape, tone, size }));
const rows = [
  { label: parents, y: 14, fruits: parentRow },
  { label: f1, y: 104, fruits: f1Row },
  { label: f2, y: 190, fruits: f2Row },
];
---
<svg class="guide-gen" viewBox="0 0 320 248" role="img" aria-label={alt}>
  {rows.map((row) => (
    <>
      <text x="4" y={row.y} class="guide-gen-label">{row.label}</text>
      {row.fruits.map((f) => (
        <g>
          <path d={f.stem} class="guide-gen-stem" />
          <ellipse cx={f.x} cy={f.y} rx={f.rx} ry={f.ry} class={f.tone === 'orange' ? 'guide-gen-orange' : 'guide-gen-green'} />
          {f.ribs.map((d) => <path d={d} class="guide-gen-rib" />)}
          {f.flecks.map((d) => <circle cx={d.cx} cy={d.cy} r={d.r} class="guide-gen-orange" />)}
        </g>
      ))}
    </>
  ))}
  <text x="160" y="55" class="guide-gen-sign" text-anchor="middle">×</text>
  {[[76, 90], [160, 176]].map(([y1, y2]) => (
    <path d={`M160 ${y1}V${y2}M155 ${y2 - 5}l5 5l5 -5`} class="guide-gen-arrow" />
  ))}
</svg>

<style>
  .guide-gen { width: 100%; max-width: 34rem; }
  .guide-gen .guide-gen-label { font-size: 12.5px; font-weight: 600; fill: var(--text-secondary); }
  .guide-gen .guide-gen-sign { font-size: 16px; fill: var(--text-muted); }
  .guide-gen-green { fill: var(--leaf); }
  .guide-gen-orange { fill: var(--seed-1); }
  .guide-gen-rib { fill: none; stroke: var(--surface); stroke-width: 1; opacity: 0.4; }
  .guide-gen-stem { fill: none; stroke: var(--leaf); stroke-width: 2.5; stroke-linecap: round; }
  .guide-gen-arrow { fill: none; stroke: var(--accent); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
</style>
