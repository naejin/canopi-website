---
// Fungal or bacterial: the steering table (plant group → compost, mulch and compost tea kinds). A
// real table from 640 px; below that each plant group becomes a block of label/value rows, so four
// long columns fit a phone. `columns` are the four headers, `rows` the cells in the same order; a
// cell may mark one phrase in bold with **…** (the "keep it off food" warning). Kinds only, never
// amounts. Words come from the MDX.
interface Props { columns: [string, string, string, string]; rows: [string, string, string, string][]; }
const { columns, rows } = Astro.props;
const parts = (cell: string) => cell.split(/\*\*(.+?)\*\*/).map((text, i) => ({ text, bold: i % 2 === 1 }));
---
<div class="guide-table-wrap guide-steer-table-wrap">
  <table class="guide-table guide-steer-table">
    <thead><tr>{columns.map((c) => <th scope="col">{c}</th>)}</tr></thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">{row[0]}</th>
          {row.slice(1).map((cell, i) => <td data-label={columns[i + 1]}><span>{parts(cell).map((p) => (p.bold ? <strong>{p.text}</strong> : p.text))}</span></td>)}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .guide-steer-table tbody th { white-space: normal; }
  .guide-steer-table td strong { font-weight: 600; color: var(--text); }
  @media (max-width: 639px) {
    .guide-steer-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .guide-steer-table tr { display: block; padding: 0.55rem 0.8rem 0.7rem; border-top: 1px solid var(--border); }
    .guide-steer-table tbody tr:first-child { border-top: 0; }
    .guide-steer-table th, .guide-steer-table td { display: block; padding: 0.15rem 0; border-top: 0; }
    .guide-steer-table tbody th { font-family: var(--font-display); font-size: 1rem; padding-bottom: 0.3rem; }
    .guide-steer-table td { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 0.6rem; }
    .guide-steer-table td::before { content: attr(data-label); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); font-weight: 600; padding-top: 0.15rem; }
  }
</style>
