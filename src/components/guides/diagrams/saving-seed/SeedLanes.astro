---
// Saving seed: the two routes side by side. Dry seed (dry on the plant, thresh, screen, winnow) on
// the left, wet seed (scoop, ferment or rinse, keep what sinks, dry, winnow) on the right; both lanes
// end in one box, "dry, then store". Labels come from the MDX; boxes grow to fit wrapped lines.
import { r1, seedOf } from '../../../../lib/svg';
interface Lane { title: string; crops: string; steps: string[]; }
interface Props { dry: Lane; wet: Lane; end: string; title: string; alt: string; }
const { dry, wet, end, title, alt } = Astro.props;
const uid = `seed-lanes-${seedOf(title + alt).toString(36)}`;
if (!dry.steps.length || !wet.steps.length) throw new Error('<SeedLanes>: each lane needs at least one step');

// Rough wrap by character count (Source Sans 3 at 11.5px is about 5.6px per character).
function wrap(text: string, max: number): string[] {
  const lines: string[] = [];
  let line = '';
  for (const word of text.split(/\s+/)) {
    if (line && (line + ' ' + word).length > max) { lines.push(line); line = word; } else line = line ? `${line} ${word}` : word;
  }
  if (line) lines.push(line);
  return lines;
}
const W = 340, LANE = 158, GAP = W - 2 * LANE, LINE = 14, PAD = 9, ARROW = 16;
const lanes = [dry, wet].map((lane, i) => {
  const x = i * (LANE + GAP);
  const head = wrap(lane.crops, 30);
  let y = 22 + head.length * 13 + 8;
  const boxes = lane.steps.map((text) => {
    const lines = wrap(text, 26);
    const h = lines.length * LINE + 2 * PAD - 4;
    const box = { x, y, h, lines };
    y += h + ARROW;
    return box;
  });
  return { x, title: lane.title, head, boxes, bottom: y - ARROW };
});
const joinY = Math.max(...lanes.map((l) => l.bottom)) + 26;
const endLines = wrap(end, 40);
const endH = endLines.length * LINE + 2 * PAD - 4;
const endW = 200, endX = (W - endW) / 2;
const H = joinY + endH + 4;
const arrowHead = (x: number, y: number) => `M${r1(x - 4)} ${r1(y - 6)}L${r1(x)} ${r1(y)}L${r1(x + 4)} ${r1(y - 6)}Z`;
---
<figure class="guide-figure">
  <svg viewBox={`0 0 ${W} ${r1(H)}`} role="img" aria-labelledby={`${uid}-t`} aria-describedby={`${uid}-d`} style="max-width: 34rem; width: 100%; margin-inline: auto;">
    <title id={`${uid}-t`}>{title}</title>
    <desc id={`${uid}-d`}>{alt}</desc>
    {lanes.map((lane) => (
      <g>
        <text x={lane.x + LANE / 2} y="14" text-anchor="middle" font-size="14" font-weight="600" style="fill: var(--accent-ink);">{lane.title}</text>
        {lane.head.map((line, k) => <text x={lane.x + LANE / 2} y={30 + k * 13} text-anchor="middle" font-size="11" class="guide-t-muted">{line}</text>)}
        {lane.boxes.map((box, k) => (
          <g>
            <rect x={box.x} y={r1(box.y)} width={LANE} height={r1(box.h)} rx="6" class="guide-paper" />
            {box.lines.map((line, j) => <text x={box.x + LANE / 2} y={r1(box.y + PAD + 7 + j * LINE)} text-anchor="middle" font-size="11.5">{line}</text>)}
            {k < lane.boxes.length - 1 && (
              <g>
                <line x1={box.x + LANE / 2} y1={r1(box.y + box.h + 2)} x2={box.x + LANE / 2} y2={r1(box.y + box.h + ARROW - 4)} class="guide-lead" />
                <path d={arrowHead(box.x + LANE / 2, box.y + box.h + ARROW - 2)} style="fill: var(--text-muted);" />
              </g>
            )}
          </g>
        ))}
        <path d={`M${lane.x + LANE / 2} ${r1(lane.bottom + 2)}V${r1(joinY - 12)}L${W / 2 + (lane.x ? 30 : -30)} ${r1(joinY - 4)}`} class="guide-lead" style="fill: none;" />
      </g>
    ))}
    <rect x={endX} y={r1(joinY)} width={endW} height={r1(endH)} rx="6" class="guide-glass" style="stroke: var(--accent); stroke-width: 1.5;" />
    {endLines.map((line, j) => <text x={W / 2} y={r1(joinY + PAD + 7 + j * LINE)} text-anchor="middle" font-size="12" font-weight="600">{line}</text>)}
  </svg>
</figure>
