---
// A crop's year by season (not months, so it reads in both hemispheres): one row per line or band,
// with sow / flower / harvest / save / select marks. rows: [{ label, marks: [{ at, kind }] }].
import { gt, guideLangOf } from '../../../i18n/guides';
const seasons = ['late-winter', 'spring', 'early-summer', 'summer', 'late-summer', 'autumn', 'winter'] as const;
const kinds = ['sow', 'flower', 'harvest', 'save', 'select'] as const;
type Mark = { at: (typeof seasons)[number]; kind: (typeof kinds)[number] };
interface Props { rows: { label: string; marks: Mark[] }[]; label?: string; }
const { rows, label } = Astro.props;
const lang = guideLangOf(Astro.currentLocale);
for (const row of rows) for (const m of row.marks) {
  if (!seasons.includes(m.at)) throw new Error(`<SeasonTimeline> at="${m.at}": use one of ${seasons.join(', ')}`);
  if (!kinds.includes(m.kind)) throw new Error(`<SeasonTimeline> kind="${m.kind}": use one of ${kinds.join(', ')}`);
}
const used = kinds.filter((k) => rows.some((r) => r.marks.some((m) => m.kind === k)));
---
<figure class="guide-figure guide-timeline" style={`--guide-seasons: ${seasons.length}`}>
  <div class="guide-timeline-grid" role="table" aria-label={label ?? gt('timeline.label', lang)}>
    <div class="guide-timeline-row guide-timeline-head" role="row">
      <span role="columnheader" class="guide-timeline-label"></span>
      {seasons.map((s) => <span role="columnheader" class="guide-timeline-season">{gt(`when.${s}`, lang)}</span>)}
    </div>
    {rows.map((row) => (
      <div class="guide-timeline-row" role="row">
        <span role="rowheader" class="guide-timeline-label">{row.label}</span>
        {seasons.map((s) => {
          const marks = row.marks.filter((m) => m.at === s);
          return (
            <span role="cell" class="guide-timeline-cell">
              {marks.map((m) => <span class={`guide-mark guide-mark-${m.kind}`} title={gt(`mark.${m.kind}`, lang)}><span class="guide-visually-hidden">{gt(`mark.${m.kind}`, lang)}</span></span>)}
            </span>
          );
        })}
      </div>
    ))}
  </div>
  <figcaption class="guide-timeline-key">
    {used.map((k) => <span><span class={`guide-mark guide-mark-${k}`} aria-hidden="true"></span>{gt(`mark.${k}`, lang)}</span>)}
  </figcaption>
</figure>
