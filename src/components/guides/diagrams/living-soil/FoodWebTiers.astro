---
// Living soil: who eats whom, as five stacked tiers read from the bottom up. `tiers` are listed
// bottom-up (food first) and drawn bottom-up, so the reading order and the visual order agree; the
// bottom tier is shaded as the base, and an "eaten by ↑" marker sits on the border above every tier
// but the top one (decorative, hidden from screen readers). `label` names the list.
interface Tier { title: string; text: string; }
interface Props { tiers: [Tier, Tier, Tier, Tier, Tier]; up: string; label: string; }
const { tiers, up, label } = Astro.props;
---
<ol class="guide-web" aria-label={label}>
  {tiers.map((t, i) => (
    <li class:list={['guide-web-tier', { 'guide-web-base': i === 0 }]}>
      <strong>{t.title}</strong>
      <span>{t.text}</span>
      {i < tiers.length - 1 && <span class="guide-web-up" aria-hidden="true">{up}</span>}
    </li>
  ))}
</ol>

<style>
  :global(.guide-body) .guide-web { display: flex; flex-direction: column-reverse; margin: 0; padding: 0; list-style: none; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  :global(.guide-body) .guide-web-tier { display: grid; grid-template-columns: 10rem minmax(0, 1fr); gap: 0.2rem 1rem; align-items: baseline; margin: 0; padding: 0.75rem 1rem; position: relative; }
  .guide-web-tier + .guide-web-tier { border-bottom: 1px solid var(--border); }
  .guide-web-base { background: var(--surface-alt); border-radius: 0 0 var(--radius) var(--radius); }
  .guide-web-tier strong { font-family: var(--font-display); font-weight: 600; font-size: 0.98rem; line-height: 1.3; }
  .guide-web-tier > span:not(.guide-web-up) { font-size: 0.93rem; line-height: 1.4; color: var(--text-secondary); }
  .guide-web-up { position: absolute; right: 0.8rem; top: -0.7rem; z-index: 1; font-size: 0.72rem; line-height: 1.3; letter-spacing: 0.04em; color: var(--text-muted); background: var(--surface); padding: 0 0.4rem; border: 1px solid var(--border); border-radius: 999px; }
  @media (max-width: 639px) {
    :global(.guide-body) .guide-web-tier { grid-template-columns: minmax(0, 1fr); padding-bottom: 0.95rem; }
  }
</style>
