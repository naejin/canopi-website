---
// Keeping a landrace: a filled-in seed packet label to copy for shared landrace seed. The packet's
// flap is a small SVG; under it the stamp ("landrace, may be crossed") and the label's lines as a
// list of name / example value. label names the figure for assistive technology.
interface Field { name: string; value: string; }
interface Props { label: string; stamp: string; fields: Field[]; }
const { label, stamp, fields } = Astro.props;
if (!fields.length) throw new Error('<SeedPacketLabel>: at least one field');
---
<figure class="guide-figure guide-packet" role="group" aria-label={label}>
  <svg viewBox="0 0 200 18" preserveAspectRatio="none" aria-hidden="true" class="guide-packet-flap">
    <path d="M1 17L12 1H188L199 17" class="guide-paper" />
  </svg>
  <div class="guide-packet-body">
    <p class="guide-packet-stamp">{stamp}</p>
    <dl>
      {fields.map((f) => (
        <div><dt>{f.name}</dt><dd>{f.value}</dd></div>
      ))}
    </dl>
  </div>
</figure>

<style>
  .guide-packet { max-width: 20rem; gap: 0; }
  .guide-packet-flap { width: 100%; height: 1.1rem; }
  .guide-packet-body { background: var(--surface-alt); border: 1px solid var(--border-strong); border-top: 0; border-radius: 0 0 var(--radius) var(--radius); padding: 0.75rem 1rem 0.9rem; }
  .guide-packet-stamp { display: inline-block; margin: 0 0 0.6rem; padding: 0.15rem 0.55rem; border: 1.5px solid var(--accent); border-radius: 4px; color: var(--accent-ink); font-weight: 600; font-size: 0.85rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .guide-packet dl { margin: 0; display: grid; gap: 0.3rem; }
  .guide-packet dl > div { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 0.6rem; border-bottom: 1px dashed var(--border-strong); padding-bottom: 0.2rem; }
  .guide-packet dt { font-size: 0.8rem; color: var(--text-muted); font-weight: 600; }
  .guide-packet dd { margin: 0; font-size: 0.92rem; }
</style>
