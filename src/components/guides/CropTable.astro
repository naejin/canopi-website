---
// A table of crops from src/data/crops.ts. columns: any of pollination, crossing, seed, ease, cms,
// life, species. Crossing, ease and hybrid columns are his estimates; the caption says so for the
// ones shown, and only then. Below 640px each crop becomes a block of label/value rows (guide styles,
// data-label), so the table never scrolls sideways; explicit roles keep it a table for screen readers.
import { crop as findCrop } from '../../data/crops';
import { gt, guideLangOf } from '../../i18n/guides';
import { cropText } from './crop-text';
import PollinationBadge from './PollinationBadge.astro';
import CropMeter from './CropMeter.astro';
const columnKeys = ['species', 'pollination', 'crossing', 'life', 'seed', 'ease', 'cms'] as const;
type Column = (typeof columnKeys)[number];
interface Props { crops: string[]; columns?: Column[]; caption?: string; }
const { crops, columns = ['pollination', 'crossing', 'seed', 'ease', 'cms'], caption } = Astro.props;
for (const c of columns) if (!columnKeys.includes(c)) throw new Error(`<CropTable columns>: "${c}" is not one of ${columnKeys.join(', ')}`);
const lang = guideLangOf(Astro.currentLocale);
const heads: Record<Column, string> = {
  species: gt('crop.species', lang), pollination: gt('crop.pollination', lang), crossing: gt('crop.crossing', lang),
  life: gt('crop.life', lang), seed: gt('crop.seed', lang), ease: gt('crop.ease', lang), cms: gt('crop.hybrids', lang),
};
// "Seed from crossing and ease to landrace: in Lofthouse's experience…", naming only the columns shown.
const his = columns.filter((c) => c === 'crossing' || c === 'ease' || c === 'cms').map((c) => heads[c]);
const listed = new Intl.ListFormat(lang === 'fr' ? 'fr' : 'en-GB', { type: 'conjunction' })
  .format(his.map((h, i) => (i === 0 ? h : h.charAt(0).toLowerCase() + h.slice(1))));
const note = his.length ? gt('table.note', lang, { columns: listed }) : null;
const rows = crops.map((id) => { const crop = findCrop(id); return { crop, text: cropText(crop, lang) }; });
const cell = (c: Column, crop: (typeof rows)[number]['crop'], text: (typeof rows)[number]['text']) =>
  c === 'species' ? crop.species : c === 'pollination' ? crop.pollination : c === 'crossing' ? text.crossing
    : c === 'life' ? text.life : c === 'seed' ? text.seed : c === 'ease' ? text.ease : text.flagged;
---
<div class="guide-table-wrap" role="region" tabindex="0" aria-label={caption ?? gt('table.crop', lang)}>
  <table class="guide-table guide-crop-table" role="table" data-columns={columns.length}>
    {(caption || note) && <caption>{caption && <span>{caption} </span>}{note && <span class="guide-table-note">{note}</span>}</caption>}
    <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">{gt('table.crop', lang)}</th>{columns.map((c) => <th scope="col" role="columnheader">{heads[c]}</th>)}</tr></thead>
    <tbody role="rowgroup">
      {rows.map(({ crop, text }) => (
        <tr role="row">
          <th scope="row" role="rowheader">{text.name}</th>
          {columns.map((c) => cell(c, crop, text)
            ? <td data-label={heads[c]} role="cell"><span class="guide-crop-value">{c === 'species' && <i>{crop.species}</i>}{c === 'pollination' && <PollinationBadge pollination={crop.pollination} />}{c === 'crossing' && <><CropMeter crossing={crop.crossing} /> {text.crossing}</>}{c === 'life' && text.life}{c === 'seed' && text.seed}{c === 'ease' && text.ease}{c === 'cms' && <span class="guide-warn">{gt('crop.flag', lang)} <span class="guide-visually-hidden">{gt('crop.flagLabel', lang)}</span></span>}</span></td>
            : <td data-label={heads[c]} role="cell"></td>)}
        </tr>
      ))}
    </tbody>
  </table>
</div>
