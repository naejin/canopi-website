---
// A small bar for the share of seed from crossing; striped where he gives a word, not a figure.
import type { Crossing } from '../../data/crops';
interface Props { crossing: Crossing | null; }
const { crossing } = Astro.props;
const width = crossing ? (crossing.pct ?? (crossing.word === 'high' ? 100 : 12)) : 0;
---
{crossing && (
  <span class:list={['guide-meter', { 'guide-meter-word': crossing.pct === null }]} aria-hidden="true"><i style={`width: ${Math.max(width, 4)}%`}></i></span>
)}
