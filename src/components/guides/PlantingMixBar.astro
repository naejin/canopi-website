---
// One year's sowing as a stacked bar: parts of own (last year's) seed, older seed and new seed.
import { gt, guideLangOf } from '../../i18n/guides';
import { mixShares, type MixPart } from './planting-mix';
interface Props { parts: MixPart[]; title?: string; }
const { parts, title } = Astro.props;
const shares = mixShares(parts);
const lang = guideLangOf(Astro.currentLocale);
const nb = lang === 'fr' ? '\u202f' : '';
const described = parts.map((p, i) => `${shares[i]}${nb}% ${p.label}`).join(', ');
---
<figure class="guide-figure guide-mix" role="img" aria-label={gt('aria.labelled', lang, { label: title ?? gt('mix.title', lang), text: described })}>
  <p class="guide-label">{title ?? gt('mix.title', lang)}</p>
  <div class="guide-mix-bar" aria-hidden="true">
    {parts.map((p, i) => <span class={`guide-mix-${p.tone}`} style={`flex: ${p.value}`}>{shares[i] >= 12 ? `${shares[i]}${nb}%` : ''}</span>)}
  </div>
  <div class="guide-mix-keys" aria-hidden="true">
    {parts.map((p, i) => <span><i class={`guide-mix-${p.tone}`}></i>{p.label}{shares[i] < 12 && ` (${shares[i]}${nb}%)`}</span>)}
  </div>
</figure>
