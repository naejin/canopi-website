---
// Inline, right after the name of a species the source flags as invasive or spreading:
// "Mesquite <Invasive />". One fixed text per language ("invasive.text"), no props, no slot.
// Phrasing content only, since it sits inside a paragraph or a list item.
import { gt, guideLangOf } from '../../i18n/guides';
const lang = guideLangOf(Astro.currentLocale);
// The icon and the first word never part, so a line break can't leave an empty piece of pill after
// the species name; the rest flows inline and the punctuation after it stays on its line.
const [lead, ...rest] = gt('invasive.text', lang).split(' ');
---
<span class="guide-invasive"><span class="guide-invasive-lead"><svg class="guide-invasive-icon" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false"><path d="M8 5.5V1.5M6 3.2 8 1.2l2 2M8 10.5v4M6 12.8l2 2 2-2M5.5 8h-4M3.2 6 1.2 8l2 2M10.5 8h4M12.8 6l2 2-2 2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>{lead}</span>{rest.length > 0 && ` ${rest.join(' ')}`}</span>
