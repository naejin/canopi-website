---
// The Field Guides index: every published guide, grouped by domain, with its promise and glance.
// Pages: src/pages/guides/index.astro (en) and src/pages/[lang]/guides/index.astro (fr).
import '../../styles/guides.css';
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import DonateDialog from '../DonateDialog.astro';
import PageData from '../PageData.astro';
import ClimateBadge from '../ClimateBadge.astro';
import ClimatePicker from '../ClimatePicker.astro';
import { guideDomains, publishedGuides, slugOf } from '../../lib/guides';
import {
  cardSkillOf,
  DOMAIN_TO_VIGNETTE,
  GUIDE_VIGNETTES,
  VIGNETTE_STROKE_WIDTH,
  VIGNETTE_VIEWBOX,
} from '../../lib/guide-vignettes';
import { gt, guideLocales, guidePath, guidesPath, type GuideLang } from '../../i18n/guides';
import { consortiumPath, localizedUrl, t } from '../../i18n/utils';
interface Props { lang: GuideLang; }
const { lang } = Astro.props;
const guides = await publishedGuides(lang);
// The climate picker joins the index once a guide has blocks for some climates only.
const climateGuides = guides.some((e) => e.data.climates);
const groups = guideDomains.map((domain) => ({ domain, guides: guides.filter((e) => e.data.domain === domain) })).filter((g) => g.guides.length);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: gt('section.title', lang),
  description: gt('section.lede', lang),
  inLanguage: lang,
  url: new URL(guidesPath(lang), Astro.site).href,
  hasPart: guides.map((e) => ({ '@type': 'Article', headline: e.data.title, url: new URL(guidePath(slugOf(e), lang), Astro.site).href })),
};
---
<Base title={`${gt('section.title', lang)} · Canopi`} description={gt('section.lede', lang)} lang={lang} path="/guides/" alternates={guideLocales} structuredData={structuredData}>
  <Header lang={lang} path="/guides/" alternates={guideLocales} current="guides" />
  <main id="main" class="guide-page">
    <div class="wrap guide-index">
      <header class="guide-index-head">
        <h1>{gt('section.title', lang)}</h1>
        <p class="guide-small">{gt('section.languages', lang)}</p>
        <p class="guide-index-books"><a href={localizedUrl('/bibliography/', lang)}>{gt('section.books', lang)}</a></p>
        <p class="guide-index-books"><a href={consortiumPath(lang)}>{t('learn.consortium.link', lang)}</a></p>
        {climateGuides && <ClimatePicker lang={lang} />}
      </header>
      {groups.map(({ domain, guides: list }) => {
        const vigKind = DOMAIN_TO_VIGNETTE[domain];
        const vigPrims = GUIDE_VIGNETTES[vigKind];
        return (
          <section class="guide-domain" id={domain} aria-labelledby={`guide-domain-${domain}`}>
            <div class="guide-domain-head">
              <svg
                class="guide-domain-vignette"
                viewBox={VIGNETTE_VIEWBOX}
                width="48"
                height="48"
                fill="none"
                stroke="currentColor"
                stroke-width={VIGNETTE_STROKE_WIDTH}
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {vigPrims.map((p) => {
                  const Tag = p.tag as 'path' | 'circle' | 'ellipse';
                  return <Tag {...p.attrs} />;
                })}
              </svg>
              <h2 id={`guide-domain-${domain}`}>{gt(`domain.${domain}`, lang)}</h2>
            </div>
            <ul class="guide-index-list" role="list">
              {list.map((e) => {
                const slug = slugOf(e);
                const skill = cardSkillOf(slug, e.data.glance, lang);
                return (
                  <li class="guide-index-item">
                    <svg
                      class="guide-card-vignette"
                      viewBox={VIGNETTE_VIEWBOX}
                      width="48"
                      height="48"
                      fill="none"
                      stroke="currentColor"
                      stroke-width={VIGNETTE_STROKE_WIDTH}
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      {vigPrims.map((p) => {
                        const Tag = p.tag as 'path' | 'circle' | 'ellipse';
                        return <Tag {...p.attrs} />;
                      })}
                    </svg>
                    <div class="guide-index-body">
                      <div class="guide-index-meta">
                        <span class="guide-index-topic">{gt(`domain.${domain}`, lang)}</span>
                        <span class="guide-index-skill">{skill}</span>
                      </div>
                      <h3><a href={guidePath(slug, lang)}>{e.data.title}</a></h3>
                      <p class="guide-index-desc">{e.data.description}</p>
                      {e.data.climates && <p class="guide-index-climates">{e.data.climates.map((zone) => <ClimateBadge zone={zone} lang={lang} />)}</p>}
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>
        );
      })}
    </div>
  </main>
  <Footer lang={lang} />
  <DonateDialog lang={lang} />
  <PageData lang={lang} keys={[]} />
  <script>
    import { initChrome } from '../../scripts/chrome.js';
    initChrome();
  </script>
</Base>
