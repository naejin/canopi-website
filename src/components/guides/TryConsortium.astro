---
// A way from a guide into the consortium tool (beta) with the guide's plant kept and its climate set:
// /consortium/?plant=<canonical_name>&climate=<id> (/fr/guilde/ in French; src/lib/consortium/state.ts
// reads the preset). plant: the canonical name in public/data/consortium/*.json; name: the guide's own
// name for it, in the guide's language. Inside a <ForClimate> block, climate is that block's zone, and
// the link is the last thing in the block; in a guide for every climate, leave it out and each beta
// cell that has the plant gets a link, so no climate is assumed. try-consortium.ts builds the links and
// fails the build when the plant is not in the cell of the climate it links to.
import { consortiumPath } from '../../i18n/utils';
import { gt, guideLangOf } from '../../i18n/guides';
import { presetCells, presetLinks } from './try-consortium';
interface Props { plant: string; name: string; climate?: string; }
const { plant, name, climate } = Astro.props;
const lang = guideLangOf(Astro.currentLocale);

// The beta's cells, read at build time. (The prerender runs in workerd, without node:fs, so the files
// come in through Vite.)
const files = import.meta.glob('../../../public/data/consortium/*.json', { eager: true, import: 'default' });
const file = <T,>(base: string) => files[`../../../public/data/consortium/${base}`] as T | undefined;
const cells = presetCells(file('manifest.json')!, file);
// The text names the cell the link opens ("Corn · Temperate Europe"), not only its climate: the beta
// covers a climate in one region, and a reader elsewhere should not expect their own.
const presets = presetLinks(consortiumPath(lang), plant, climate, cells);
const links = presets.map((link) => ({
  href: link.href,
  text: gt('consortium.link', lang, { plant: name, cell: link.regions.map((region) => gt(`consortium.cell.${link.climate}.${region}`, lang)).join(' / ') }),
}));
const id = `try-consortium-${plant.toLowerCase().replace(/[^a-z]+/g, '-')}-${presets.map((link) => link.climate).join('-')}`;
---
<p class="guide-next-inline">
  <span class="guide-label" id={id}>{gt('consortium.label', lang)}</span>
  {links.map((link) => <a href={link.href} aria-describedby={id}>{link.text}</a>)}
</p>
