{
	"compatibility_date": "2026-04-02",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "projectcanopi",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// The contact form (src/pages/api/contact.ts) mails the site's owner through Email Routing.
	"send_email": [
		{
			"name": "EMAIL",
			"destination_address": "projectcanopi@gmail.com",
			"allowed_sender_addresses": ["contact@projectcanopi.com"]
		}
	],
	"vars": {
		"MAIL_TO": "projectcanopi@gmail.com"
	},
	"observability": {
		"enabled": true
	}
}