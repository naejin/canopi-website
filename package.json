{
  "name": "canopi-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "wrangler types && astro check",
    "check:arch": "node scripts/quality/ratchet.mjs arch",
    "check:dup": "node scripts/quality/ratchet.mjs dup",
    "check:dead": "node scripts/quality/ratchet.mjs dead",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test scripts/*.test.mjs",
    "test:vectors": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test scripts/climate-vectors.test.mjs",
    "build:browser-test": "CANOPI_BROWSER_TEST=1 astro build",
    "test:browser": "npm run build:browser-test && node scripts/browser/run.mjs --list local",
    "test:browser:shard": "node scripts/browser/run.mjs --list ci --no-scope --shard",
    "test:browser:smoke": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --experimental-test-isolation=none --test-timeout=90000 --test-force-exit scripts/browser/smoke/consortium.smoke.mjs",
    "test:axe": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --experimental-test-isolation=none --test-timeout=90000 --test-force-exit scripts/browser/smoke/axe.smoke.mjs",
    "timing:consortium": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/browser/consortium-timing.mjs",
    "check:bibliography": "node scripts/check-bibliography-links.mjs",
    "build": "astro build",
    "install:web-edition": "node scripts/install-web-edition.mjs",
    "install:consortium": "node scripts/install-consortium.mjs",
    "install:climate": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/install-climate.mjs",
    "build:with-web": "npm run build && npm run install:web-edition",
    "preview": "npm run build:with-web && wrangler dev",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "npm run build:with-web && wrangler deploy",
    "hooks:install": "node -e \"console.log('Run once in the main checkout (a relative path applies to every worktree):\\n  git config core.hooksPath .githooks')\""
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.7",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/sitemap": "^3.7.2",
    "@preact/signals": "2.11.3",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "astro": "^6.1.3",
    "maplibre-gl": "6.10.0",
    "preact": "11.0.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.2",
    "@astrojs/check": "^0.9.12",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "axe-core": "4.14.0",
    "css-select": "^5.2.2",
    "dependency-cruiser": "18.7.2",
    "dom-serializer": "^2.0.0",
    "domhandler": "^5.0.3",
    "js-yaml": "^4.1.1",
    "jscpd": "5.4.3",
    "knip": "6.45.1",
    "parse5": "^7.3.0",
    "puppeteer-core": "25.16.0",
    "wrangler": "^4.80.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
