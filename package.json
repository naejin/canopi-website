{
  "name": "canopi-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "wrangler types && astro check",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test scripts/*.test.mjs",
    "build:browser-test": "CANOPI_BROWSER_TEST=1 PUBLIC_CT_TEST_HOOK=1 astro build",
    "test:browser": "npm run build:browser-test && node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-concurrency=1 scripts/browser/*.browser.test.mjs",
    "check:bibliography": "node scripts/check-bibliography-links.mjs",
    "build": "astro build",
    "install:web-edition": "node scripts/install-web-edition.mjs",
    "install:consortium": "node scripts/install-consortium.mjs",
    "build:with-web": "npm run build && npm run install:web-edition",
    "preview": "npm run build:with-web && wrangler dev",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "npm run build:with-web && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.7",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/sitemap": "^3.7.2",
    "@preact/signals": "2.11.3",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "astro": "^6.1.3",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "css-select": "^5.2.2",
    "dom-serializer": "^2.0.0",
    "domhandler": "^5.0.3",
    "js-yaml": "^4.1.1",
    "parse5": "^7.3.0",
    "puppeteer-core": "25.16.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.80.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
